<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <surfacematerial name="gold" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="gold_surface" />
  </surfacematerial>
  <open_pbr_surface name="gold_surface" type="surfaceshader">
    <input name="base_color" type="color3" value="0.944, 0.776, 0.373" />
    <input name="base_metalness" type="float" value="1" />
    <input name="specular_weight" type="float" value="1" />
    <input name="specular_roughness" type="float" value="0.02" />
  </open_pbr_surface>
</materialx>
