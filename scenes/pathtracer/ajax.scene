renderer
{
	resolution 900 900
	maxdepth 2
	tilewidth 100
	tileheight 100
	envmapfile HDR/sunset.hdr
	envmapintensity 5.0
}

camera
{
	position 0.0 0.5 -1.8
	lookat 0 0.5 0.0
	fov 35
}

material silver
{
	color 1.0 1.0 1.0
	roughness 0.1
	metallic 1.0	
}

material gold
{
	color 1.0 0.71 0.29
	roughness 0.1
	metallic 1.0	
}

material redPlastic
{
	color 1.0 0.0 0.0
	roughness 0.01
	metallic 0.0
}

material white
{
	color 1.0 1.0 1.0
	roughness 0.01
	metallic 0.0
}

material black
{
	color 0.1 0.1 0.1
	roughness 0.01
	metallic 1.0
}

material glass
{
	color 1.0 1.0 1.0
	materialType 1.0
	ior 1.45
}

mesh
{
	file ajax/ajax.obj
	material black
}

