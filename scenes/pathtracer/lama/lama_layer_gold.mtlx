<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <standard_surface name="ground_surface" type="surfaceshader">
    <input name="base_color" type="color3" nodename="ground_albedo" />
    <input name="specular_roughness" type="float" value="0.8" />
  </standard_surface>
  <image name="ground_texture" type="color3">
    <input name="file" type="filename" value="../renderman/textures/checker.png" />
  </image>
  <power name="ground_albedo" type="color3">
    <input name="in1" type="color3" nodename="ground_texture" />
    <input name="in2" type="color3" value="2.2, 2.2, 2.2" />
  </power>
  <surfacematerial name="ground" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="ground_surface" />
  </surfacematerial>

  <standard_surface name="stand_surface" type="surfaceshader">
    <input name="base_color" type="color3" value="0.025, 0.02, 0.012" />
    <input name="metalness" type="float" value="1" />
    <input name="specular_roughness" type="float" value="0.28" />
  </standard_surface>
  <surfacematerial name="stand" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="stand_surface" />
  </surfacematerial>

  <LamaConductor name="gold_base" type="BSDF">
    <input name="fresnelMode" type="integer" value="1" />
    <input name="IOR" type="vector3" value="0.18, 0.42, 1.37" />
    <input name="extinction" type="vector3" value="3.42, 2.35, 1.77" />
    <input name="roughness" type="float" value="0.22" />
    <input name="anisotropy" type="float" value="0" />
    <input name="tint" type="color3" value="1, 1, 1" />
  </LamaConductor>

  <LamaDielectric name="dielectric_ior_1_0" type="BSDF">
    <input name="fresnelMode" type="integer" value="1" />
    <input name="IOR" type="float" value="1" />
    <input name="roughness" type="float" value="0.08" />
  </LamaDielectric>
  <LamaDielectric name="dielectric_ior_1_5" type="BSDF">
    <input name="fresnelMode" type="integer" value="1" />
    <input name="IOR" type="float" value="1.5" />
    <input name="roughness" type="float" value="0.08" />
  </LamaDielectric>
  <LamaDielectric name="dielectric_ior_2_0" type="BSDF">
    <input name="fresnelMode" type="integer" value="1" />
    <input name="IOR" type="float" value="2" />
    <input name="roughness" type="float" value="0.08" />
  </LamaDielectric>
  <LamaDielectric name="dielectric_ior_2_5" type="BSDF">
    <input name="fresnelMode" type="integer" value="1" />
    <input name="IOR" type="float" value="2.5" />
    <input name="roughness" type="float" value="0.08" />
  </LamaDielectric>
  <LamaDielectric name="dielectric_ior_3_0" type="BSDF">
    <input name="fresnelMode" type="integer" value="1" />
    <input name="IOR" type="float" value="3" />
    <input name="roughness" type="float" value="0.08" />
  </LamaDielectric>

  <LamaLayer name="layer_ior_1_0" type="BSDF">
    <input name="materialTop" type="BSDF" nodename="dielectric_ior_1_0" />
    <input name="materialBase" type="BSDF" nodename="gold_base" />
    <input name="topMix" type="float" value="1" />
  </LamaLayer>
  <LamaLayer name="layer_ior_1_5" type="BSDF">
    <input name="materialTop" type="BSDF" nodename="dielectric_ior_1_5" />
    <input name="materialBase" type="BSDF" nodename="gold_base" />
    <input name="topMix" type="float" value="1" />
  </LamaLayer>
  <LamaLayer name="layer_ior_2_0" type="BSDF">
    <input name="materialTop" type="BSDF" nodename="dielectric_ior_2_0" />
    <input name="materialBase" type="BSDF" nodename="gold_base" />
    <input name="topMix" type="float" value="1" />
  </LamaLayer>
  <LamaLayer name="layer_ior_2_5" type="BSDF">
    <input name="materialTop" type="BSDF" nodename="dielectric_ior_2_5" />
    <input name="materialBase" type="BSDF" nodename="gold_base" />
    <input name="topMix" type="float" value="1" />
  </LamaLayer>
  <LamaLayer name="layer_ior_3_0" type="BSDF">
    <input name="materialTop" type="BSDF" nodename="dielectric_ior_3_0" />
    <input name="materialBase" type="BSDF" nodename="gold_base" />
    <input name="topMix" type="float" value="1" />
  </LamaLayer>

  <LamaSurface name="gold_ior_1_0" type="material">
    <input name="materialFront" type="BSDF" nodename="layer_ior_1_0" />
    <input name="materialBack" type="BSDF" nodename="layer_ior_1_0" />
    <input name="presence" type="float" value="1" />
  </LamaSurface>
  <LamaSurface name="gold_ior_1_5" type="material">
    <input name="materialFront" type="BSDF" nodename="layer_ior_1_5" />
    <input name="materialBack" type="BSDF" nodename="layer_ior_1_5" />
    <input name="presence" type="float" value="1" />
  </LamaSurface>
  <LamaSurface name="gold_ior_2_0" type="material">
    <input name="materialFront" type="BSDF" nodename="layer_ior_2_0" />
    <input name="materialBack" type="BSDF" nodename="layer_ior_2_0" />
    <input name="presence" type="float" value="1" />
  </LamaSurface>
  <LamaSurface name="gold_ior_2_5" type="material">
    <input name="materialFront" type="BSDF" nodename="layer_ior_2_5" />
    <input name="materialBack" type="BSDF" nodename="layer_ior_2_5" />
    <input name="presence" type="float" value="1" />
  </LamaSurface>
  <LamaSurface name="gold_ior_3_0" type="material">
    <input name="materialFront" type="BSDF" nodename="layer_ior_3_0" />
    <input name="materialBack" type="BSDF" nodename="layer_ior_3_0" />
    <input name="presence" type="float" value="1" />
  </LamaSurface>
</materialx>
