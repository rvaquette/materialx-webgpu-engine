#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    doc = "coffee_pot converted from GLSL-PathTracer .scene"
)

def Xform "World"
{
    custom string pathtracer:sourceScene = "coffee_pot.scene"
    custom int2 pathtracer:resolution = (700, 900)
    custom int pathtracer:maxDepth = 5

    def Camera "Camera"
    {
        matrix4d xformOp:transform = ((1, 0, 0, 0), (0, 0.992277876714, -0.124034734589, 0), (0, 0.124034734589, 0.992277876714, 0), (0, 0.26, 0.7, 1))
        uniform token[] xformOpOrder = ["xformOp:transform"]
        token projection = "perspective"
        float focalLength = 50
        float horizontalAperture = 26.7949192431
        float verticalAperture = 34.4506104554
        float2 clippingRange = (0.001, 1000000)
        custom point3f pathtracer:lookAt = (0, 0.16, -0.1)
        custom float pathtracer:fov = 30
    }

    def Scope "Looks"
    {
        def Material "Plastic_Orange" (
