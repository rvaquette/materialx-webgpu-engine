{
  "name": "materialx-webgpu-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "WebGPU rendering engine for OpenUSD scenes with a TypeScript MaterialX compiler.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/package-static.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:local-gpu": "node scripts/run-local-corpus.mjs",
    "test:local-scene": "node scripts/run-local-scene.mjs",
    "test:local-bxdf": "node scripts/run-local-bxdf.mjs",
    "test:device": "node scripts/run-device-corpus.mjs",
    "test:scene-device": "node scripts/run-scene-device.mjs",
    "test:bxdf-device": "node scripts/run-bxdf-device.mjs",
    "render:usd-matrix": "node scripts/run-usd-matrix-local.mjs",
    "build:fixtures": "node scripts/build-shaderball-fixture.mjs && node scripts/build-scene-materials.ts",
    "build:materials": "node scripts/build-scene-materials.ts",
    "render:scenes": "node scripts/render-scenes.ts",
    "validate:scene": "vite-node scripts/validate-disney-gold.ts"
  },
  "dependencies": {
    "comlink": "4.4.2",
    "idb": "8.0.1",
    "wgpu-matrix": "3.4.0"
  },
  "devDependencies": {
    "@needle-tools/usd": "^1.1.2",
    "@types/three": "^0.186.0",
    "@webgpu/types": "0.1.60",
    "three": "^0.186.1",
    "typescript": "5.7.2",
    "vite": "8.3.4",
    "vite-node": "^6.0.0",
    "vitest": "5.0.3"
  }
}
