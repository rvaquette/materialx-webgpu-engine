#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    doc = "rank3police converted from GLSL-PathTracer .scene"
)

def Xform "World"
{
    custom string pathtracer:sourceScene = "rank3police.scene"
    custom int2 pathtracer:resolution = (1280, 720)
    custom int pathtracer:maxDepth = 2
    custom asset pathtracer:environment = @./HDR/white_cliff_top_1k.hdr@

    def Camera "Camera"
    {
        matrix4d xformOp:transform = ((0.703077780362, 0, -0.711112954995, 0), (-0.0106909583532, 0.999886981213, -0.0105701565639, 0), (0.711032585871, 0.0150341212013, 0.702998319364, 0), (70.8, -0.503, 70, 1))
        uniform token[] xformOpOrder = ["xformOp:transform"]
        token projection = "perspective"
        float focalLength = 50
        float horizontalAperture = 16.0174048786
        float verticalAperture = 9.00979024421
        float2 clippingRange = (0.001, 1000000)
        custom point3f pathtracer:lookAt = (0, -2, 0)
        custom float pathtracer:fov = 18.2
    }

