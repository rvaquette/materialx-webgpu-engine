  <multiply name="waveHeight1" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="waveSquare1" />
    <input name="in2" type="float" value="0.52" />
  </multiply>
  <multiply name="waveX2" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="xScaled" />
    <input name="in2" type="float" value="1.8027" />
  </multiply>
  <multiply name="waveZ2" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="zScaled" />
    <input name="in2" type="float" value="-2.2716" />
  </multiply>
  <add name="waveSpace2" type="float" nodedef="ND_add_float">
    <input name="in1" type="float" nodename="waveX2" />
    <input name="in2" type="float" nodename="waveZ2" />
  </add>
  <multiply name="waveTime2" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="phase" />
    <input name="in2" type="float" value="2.3841" />
  </multiply>
  <add name="wavePhase2" type="float" nodedef="ND_add_float">
    <input name="in1" type="float" nodename="waveSpace2" />
    <input name="in2" type="float" nodename="waveTime2" />
  </add>
  <sin name="waveSine2" type="float">
