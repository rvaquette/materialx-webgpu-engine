renderer
{
    resolution 1280 720
    maxdepth 8
    tilewidth 256
    tileheight 144
    envmapfile HDR/san_giuseppe_bridge_2k.hdr
    envmapirradiancefile HDR/irradiance/san_giuseppe_bridge.hdr
}

camera
{
    position -0.05 1.05 3.58
    lookat -0.05 1.05 -0.06
    fov 45
}

material mtlx_test
{
    materialx_document ../materialx/materials/Examples/StandardSurface/standard_surface_glass.mtlx
}

material mtlx_default
{
    materialx_document ../materialx/materials/Examples/StandardSurface/standard_surface_default.mtlx
}

gltf
{
    file ShaderBall.glb
    object Preview_Mesh mtlx_test
    object Calibration_Mesh mtlx_default
}
