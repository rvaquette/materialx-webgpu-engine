<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <disney_principled name="blue_tiles_surface" type="surfaceshader">
    <input name="baseColor" type="color3" nodename="blue_tiles_baseColorTexture" />
    <input name="metallic" type="float" nodename="blue_tiles_metallicRoughnessChannels" output="outz" />
    <input name="roughness" type="float" nodename="blue_tiles_metallicRoughnessChannels" output="outy" />
  </disney_principled>
  <image name="blue_tiles_baseColorTexture" type="color3">
