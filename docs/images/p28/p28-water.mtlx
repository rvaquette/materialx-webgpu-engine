  <multiply name="waveSquare2" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="waveHalf2" />
    <input name="in2" type="float" nodename="waveHalf2" />
  </multiply>
  <multiply name="waveHeight2" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="waveSquare2" />
    <input name="in2" type="float" value="0.32" />
  </multiply>
  <multiply name="waveX3" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="xScaled" />
    <input name="in2" type="float" value="-1.5195" />
  </multiply>
  <multiply name="waveZ3" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="zScaled" />
    <input name="in2" type="float" value="4.4476" />
  </multiply>
  <add name="waveSpace3" type="float" nodedef="ND_add_float">
    <input name="in1" type="float" nodename="waveX3" />
    <input name="in2" type="float" nodename="waveZ3" />
  </add>
  <multiply name="waveTime3" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="phase" />
    <input name="in2" type="float" value="3.0351" />
  </multiply>
  <add name="wavePhase3" type="float" nodedef="ND_add_float">
    <input name="in1" type="float" nodename="waveSpace3" />
    <input name="in2" type="float" nodename="waveTime3" />
  </add>
  <sin name="waveSine3" type="float">
    <input name="in" type="float" nodename="wavePhase3" />
  </sin>
  <add name="waveRaised3" type="float" nodedef="ND_add_float">
    <input name="in1" type="float" nodename="waveSine3" />
    <input name="in2" type="float" value="1" />
  </add>
  <multiply name="waveHalf3" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="waveRaised3" />
    <input name="in2" type="float" value="0.5" />
  </multiply>
  <multiply name="waveSquare3" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="waveHalf3" />
    <input name="in2" type="float" nodename="waveHalf3" />
  </multiply>
  <multiply name="waveHeight3" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="waveSquare3" />
    <input name="in2" type="float" value="0.22" />
  </multiply>
  <multiply name="waveX4" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="xScaled" />
    <input name="in2" type="float" value="-5.383" />
  </multiply>
  <multiply name="waveZ4" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="zScaled" />
    <input name="in2" type="float" value="-4.9309" />
  </multiply>
  <add name="waveSpace4" type="float" nodedef="ND_add_float">
    <input name="in1" type="float" nodename="waveX4" />
    <input name="in2" type="float" nodename="waveZ4" />
  </add>
  <multiply name="waveTime4" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="phase" />
    <input name="in2" type="float" value="3.7826" />
  </multiply>
  <add name="wavePhase4" type="float" nodedef="ND_add_float">
    <input name="in1" type="float" nodename="waveSpace4" />
    <input name="in2" type="float" nodename="waveTime4" />
  </add>
  <sin name="waveSine4" type="float">
    <input name="in" type="float" nodename="wavePhase4" />
  </sin>
  <add name="waveRaised4" type="float" nodedef="ND_add_float">
    <input name="in1" type="float" nodename="waveSine4" />
    <input name="in2" type="float" value="1" />
  </add>
  <multiply name="waveHalf4" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="waveRaised4" />
    <input name="in2" type="float" value="0.5" />
  </multiply>
  <multiply name="waveSquare4" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="waveHalf4" />
    <input name="in2" type="float" nodename="waveHalf4" />
  </multiply>
  <multiply name="waveHeight4" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="waveSquare4" />
    <input name="in2" type="float" value="0.14" />
  </multiply>
  <add name="waveAccumulated0" type="float" nodedef="ND_add_float">
    <input name="in1" type="float" nodename="waveHeight0" />
    <input name="in2" type="float" nodename="waveHeight1" />
  </add>
  <add name="waveAccumulated1" type="float" nodedef="ND_add_float">
    <input name="in1" type="float" nodename="waveAccumulated0" />
    <input name="in2" type="float" nodename="waveHeight2" />
  </add>
  <add name="waveAccumulated2" type="float" nodedef="ND_add_float">
    <input name="in1" type="float" nodename="waveAccumulated1" />
    <input name="in2" type="float" nodename="waveHeight3" />
  </add>
  <add name="waveAccumulated3" type="float" nodedef="ND_add_float">
    <input name="in1" type="float" nodename="waveAccumulated2" />
    <input name="in2" type="float" nodename="waveHeight4" />
  </add>
  <subtract name="waveSum" type="float" nodedef="ND_subtract_float">
    <input name="in1" type="float" nodename="waveAccumulated3" />
    <input name="in2" type="float" value="0.75" />
  </subtract>
  <multiply name="waveHeightValue" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="waveSum" />
    <input name="in2" type="float" value="0.08" />
  </multiply>
  <displacement name="waveDisplacement" type="displacementshader">
    <input name="displacement" type="float" nodename="waveHeightValue" />
  </displacement>
  <multiply name="foamBreakup" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="detailNoise" />
    <input name="in2" type="float" value="0.5" />
  </multiply>
  <add name="foamInput" type="float" nodedef="ND_add_float">
    <input name="in1" type="float" nodename="waveSum" />
    <input name="in2" type="float" nodename="foamBreakup" />
  </add>
  <smoothstep name="foamMask" type="float" nodedef="ND_smoothstep_float">
    <input name="in" type="float" nodename="foamInput" />
    <input name="low" type="float" value="0.82" />
    <input name="high" type="float" value="1.1" />
  </smoothstep>
  <mix name="surfaceColor" type="color3">
    <input name="fg" type="color3" value="0.8, 0.92, 0.9" />
    <input name="bg" type="color3" value="0.02, 0.22, 0.3" />
    <input name="mix" type="float" nodename="foamMask" />
  </mix>
  <combine3 name="detailOffset" type="vector3" nodedef="ND_combine3_vector3">
    <input name="in1" type="float" nodename="phase" />
    <input name="in2" type="float" value="0" />
    <input name="in3" type="float" nodename="crossTime" />
  </combine3>
  <add name="detailPosition" type="vector3" nodedef="ND_add_vector3">
    <input name="in1" type="vector3" nodename="position" />
    <input name="in2" type="vector3" nodename="detailOffset" />
  </add>
  <multiply name="detailScale" type="vector3" nodedef="ND_multiply_vector3">
    <input name="in1" type="vector3" nodename="detailPosition" />
    <input name="in2" type="vector3" value="8, 8, 8" />
  </multiply>
  <noise3d name="detailNoise" type="float" nodedef="ND_noise3d_float">
    <input name="position" type="vector3" nodename="detailScale" />
    <input name="amplitude" type="float" value="1" />
    <input name="pivot" type="float" value="0" />
  </noise3d>
  <bump name="detailNormal" type="vector3">
    <input name="height" type="float" nodename="detailNoise" />
    <input name="scale" type="float" value="0.025" />
  </bump>
  <subtract name="transmissionWeight" type="float" nodedef="ND_subtract_float">
    <input name="in1" type="float" value="1" />
    <input name="in2" type="float" nodename="foamMask" />
  </subtract>
  <mix name="waterRoughness" type="float" nodedef="ND_mix_float">
    <input name="fg" type="float" value="0.4" />
    <input name="bg" type="float" value="0.08" />
    <input name="mix" type="float" nodename="foamMask" />
  </mix>
  <standard_surface name="waterSurface" type="surfaceshader">
    <input name="base" type="float" nodename="foamMask" />
    <input name="base_color" type="color3" nodename="surfaceColor" />
    <input name="specular_roughness" type="float" nodename="waterRoughness" />
    <input name="specular_IOR" type="float" value="1.333" />
    <input name="transmission" type="float" nodename="transmissionWeight" />
    <input name="transmission_color" type="color3" value="0.015, 0.08, 0.12" />
    <input name="transmission_depth" type="float" value="2" />
    <input name="normal" type="vector3" nodename="detailNormal" />
  </standard_surface>
  <surfacematerial name="material" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="waterSurface" />
    <input name="displacementshader" type="displacementshader" nodename="waveDisplacement" />
  </surfacematerial>
</materialx>
