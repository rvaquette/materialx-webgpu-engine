#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World"
{
    def Scope "Looks"
    {
        def Material "target"
        {
            token outputs:surface.connect = </World/Looks/target/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.76, 0.28, 0.08)
                float inputs:roughness = 0.24
                token outputs:surface
            }
        }
        def Material "floor"
        {
            token outputs:surface.connect = </World/Looks/floor/Surface.outputs:surface>
            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.12, 0.14, 0.18)
                float inputs:roughness = 0.78
                token outputs:surface
            }
        }
    }

    def Scope "Geometry"
    {
        def Mesh "Floor"
        {
            int[] faceVertexCounts = [4]
            int[] faceVertexIndices = [0, 1, 2, 3]
            point3f[] points = [(-3, 0, 3), (3, 0, 3), (3, 0, -3), (-3, 0, -3)]
            rel material:binding = </World/Looks/floor>
        }
        def Mesh "Target"
        {
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 2, 3, 1, 4, 5, 7, 6, 0, 1, 5, 4, 2, 6, 7, 3, 0, 4, 6, 2, 1, 3, 7, 5]
            point3f[] points = [(-0.75, 0, -0.75), (0.75, 0, -0.75), (-0.75, 1.5, -0.75), (0.75, 1.5, -0.75), (-0.75, 0, 0.75), (0.75, 0, 0.75), (-0.75, 1.5, 0.75), (0.75, 1.5, 0.75)]
            float3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            rel material:binding = </World/Looks/target>
        }
    }

    def SpotLight "Spot"
    {
        float inputs:intensity = 24
        float inputs:exposure = 0
        float inputs:shaping:cone:innerAngle = 22
        float inputs:shaping:cone:outerAngle = 42
        float3 xformOp:translate = (0, 4, 4)
        float3 xformOp:rotateXYZ = (-40, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
    }
}
