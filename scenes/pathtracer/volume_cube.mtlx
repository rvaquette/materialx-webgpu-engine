<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <anisotropic_vdf name="volume_vdf" type="VDF">
    <input name="absorption" type="vector3" value="0.08, 0.3, 0.6" />
    <input name="scattering" type="vector3" value="0.4, 0.4, 0.4" />
    <input name="anisotropy" type="float" value="0.3" />
  </anisotropic_vdf>
  <volume name="volume_shader" type="volumeshader">
    <input name="vdf" type="VDF" nodename="volume_vdf" />
  </volume>
  <surfacematerial name="volume" type="material">
    <input name="volumeshader" type="volumeshader" nodename="volume_shader" />
  </surfacematerial>
  <standard_surface name="black_surface" type="surfaceshader">
    <input name="base_color" type="color3" value="0.1, 0.1, 0.1" />
    <input name="specular_roughness" type="float" value="0.707106781187" />
    <input name="diffuse_roughness" type="float" value="0.5" />
    <input name="transmission_color" type="color3" value="0.1, 0.1, 0.1" />
    <input name="subsurface_color" type="color3" value="0.1, 0.1, 0.1" />
    <input name="coat_roughness" type="float" value="0.316227766017" />
    <input name="emission" type="float" value="1" />
    <input name="emission_color" type="color3" value="0, 0, 0" />
  </standard_surface>
  <surfacematerial name="black" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="black_surface" />
  </surfacematerial>
</materialx>
