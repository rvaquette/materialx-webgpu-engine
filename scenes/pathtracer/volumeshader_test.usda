#usda 1.0
(
    defaultPrim = "World"
    doc = "Pure volumeshader test scene"
    endTimeCode = 100
    framesPerSecond = 24
    metersPerUnit = 1
    startTimeCode = 1
    timeCodesPerSecond = 24
    upAxis = "Y"
)

def Xform "World"
{
    def Xform "Camera"
    {
        float3 xformOp:rotateXYZ = (0, 0, 0)
        float3 xformOp:scale = (1, 1, 1)
        float3 xformOp:translate = (0, 1.2, 3.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]

        def Camera "camera"
        {
            float focalLength = 50
            float horizontalAperture = 36
            float verticalAperture = 24
            token projection = "perspective"
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Sphere "VolumeTestSphere"
    {
        float3 extent = (1.0, 1.0, 1.0)
        double radius = 1.0
        float3 xformOp:scale = (1.5, 1.5, 1.5)
        float3 xformOp:translate = (0, 1.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]

        rel material:binding = </World/Materials/VolumeMaterial>
    }

    def Xform "GroundPlane"
    {
        float3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Cube "FloorCube"
        {
            float3 extent = (20, 0.1, 20)
            float3 xformOp:scale = (10, 0.05, 10)
            float3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </World/Materials/FloorMaterial>
        }
    }

    def Xform "Lighting"
    {
        def SphereLight "Keylight"
        {
            float intensity = 2.0
            float radius = 0.5
            float3 xformOp:translate = (3, 4, 3)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def DomeLight "Envlight"
        {
            float intensity = 0.3
        }
    }

    def Xform "Materials"
    {
        def Material "VolumeMaterial"
        {
            token inputs:file = @volumeshader_test.mtlx@
            token inputs:mtlxNodeName = "test_volumetric_medium"
        }

        def Material "FloorMaterial"
        {
            token inputs:file = @volumeshader_test.mtlx@
            token inputs:mtlxNodeName = "background"
        }
    }
}
