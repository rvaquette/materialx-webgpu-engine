renderer
{
    resolution 1280 720
    maxdepth 8
    tilewidth 256
    tileheight 144
    enabletonemap false
}

camera
{
    position 7.5 5 7
    lookat 0 0 0
    fov 45
}

material brass_wire_mesh
{
    materialx_document ../materialx/materials/TestSuite/libraries/metal/brass_wire_mesh.mtlx
    materialx_surface Brass_Wire_Mesh
}

material ground
{
    color 0.50 0.50 0.50
    roughness 0.55
    metallic 0.0
}

mesh
{
    name cube_brass_wire
    file material_test/cube.obj
    material brass_wire_mesh
}

mesh
{
    name sphere_brass_wire
    file material_test/sphere.obj
    material brass_wire_mesh
}

mesh
{
    name ground
    file material_test/floor.obj
    material ground
}

light
{
    emission 5.0 5.0 5.0
    position 1 5 1
    radius 1.0
    type sphere
}

light
{
    emission 3.125 3.125 3.125
    position -3.500000 2.500000 0.500000
    v2 -1.500000 2.500000 0.500000
    v1 -3.500000 2.500000 -1.500000
    type quad
}
