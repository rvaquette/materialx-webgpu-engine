<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <disney_principled name="marble_surface" type="surfaceshader">
    <input name="baseColor" type="color3" nodename="marble_baseColorTexture" />
    <input name="metallic" type="float" nodename="marble_metallicRoughnessChannels" output="outz" />
    <input name="roughness" type="float" nodename="marble_metallicRoughnessChannels" output="outy" />
  </disney_principled>
  <image name="marble_baseColorTexture" type="color3">
    <input name="file" type="filename" value="renderman/textures/marble_base.png" />
  </image>
  <image name="marble_metallicRoughnessTexture" type="color3">
    <input name="file" type="filename" value="renderman/textures/marble_mat_rgh.png" />
  </image>
  <separate3 name="marble_metallicRoughnessChannels" type="multioutput">
    <input name="in" type="color3" nodename="marble_metallicRoughnessTexture" />
  </separate3>
  <surfacematerial name="marble" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="marble_surface" />
  </surfacematerial>
  <disney_principled name="purple_cloth_surface" type="surfaceshader">
    <input name="baseColor" type="color3" value="0.073, 0.01, 0.25" />
    <input name="roughness" type="float" value="1" />
    <input name="sheen" type="float" value="1" />
  </disney_principled>
  <surfacematerial name="purple_cloth" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="purple_cloth_surface" />
  </surfacematerial>
  <disney_principled name="base_surface" type="surfaceshader">
    <input name="baseColor" type="color3" value="0.01, 0.01, 0.01" />
    <input name="metallic" type="float" value="1" />
    <input name="roughness" type="float" value="0.5" />
  </disney_principled>
  <surfacematerial name="base" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="base_surface" />
  </surfacematerial>
  <disney_principled name="checker_surface" type="surfaceshader">
    <input name="baseColor" type="color3" nodename="checker_baseColorTexture" />
    <input name="metallic" type="float" value="0" />
    <input name="roughness" type="float" value="0.5" />
  </disney_principled>
  <image name="checker_baseColorTexture" type="color3">
    <input name="file" type="filename" value="renderman/textures/checker.png" />
  </image>
  <surfacematerial name="checker" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="checker_surface" />
  </surfacematerial>
</materialx>
