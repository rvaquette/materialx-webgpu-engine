<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <LamaSSS name="base" type="BSDF">
    <input name="color" type="color3" value="0.72, 0.28, 0.18" />
    <input name="sssRadius" type="color3" value="12, 6, 3" />
    <input name="sssUnitLength" type="float" value="0.001" />
    <input name="sssMode" type="integer" value="2" />
    <input name="albedoInversionMethod" type="integer" value="1" />
  </LamaSSS>
  <LamaDielectric name="coat" type="BSDF">
    <input name="fresnelMode" type="integer" value="1" />
    <input name="IOR" type="float" value="1.5" />
    <input name="roughness" type="float" value="0.2" />
  </LamaDielectric>
  <LamaLayer name="layer" type="BSDF">
    <input name="materialTop" type="BSDF" nodename="coat" />
    <input name="materialBase" type="BSDF" nodename="base" />
    <input name="topMix" type="float" value="0.6" />
  </LamaLayer>
  <surface name="skin_surface" type="surfaceshader">
    <input name="bsdf" type="BSDF" nodename="layer" />
  </surface>
  <surfacematerial name="OpenPBRMaterial" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="skin_surface" />
  </surfacematerial>
</materialx>