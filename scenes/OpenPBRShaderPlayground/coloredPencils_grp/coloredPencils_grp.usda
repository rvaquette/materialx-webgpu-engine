            {
                uniform token subdivisionScheme = "catmullClark"
            }

            over "pencil_frntMidLft_grp2FBXASC032eraser_holder_001_mesh6"
            {
                uniform token subdivisionScheme = "catmullClark"
            }

            over "eraser_001_meshFBXASC032pencil_frntMidLft_grp2"
