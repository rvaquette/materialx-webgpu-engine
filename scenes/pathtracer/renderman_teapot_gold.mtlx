<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <standard_surface name="gold_surface" type="surfaceshader">
    <input name="base_color" type="color3" nodename="gold_albedo_factor" />
    <input name="metalness" type="float" nodename="gold_metallic_roughness_channels" output="outz" />
    <input name="specular_roughness" type="float" nodename="gold_roughness_minimum" />
    <input name="diffuse_roughness" type="float" nodename="gold_diffuse_roughness" />
    <input name="transmission_color" type="color3" value="0.9, 0.618, 0.1" />
    <input name="subsurface_color" type="color3" nodename="gold_albedo_factor" />
    <input name="coat_roughness" type="float" value="0.316227766017" />
    <input name="normal" type="vector3" nodename="gold_normal_mapped" />
    <input name="emission" type="float" value="1" />
    <input name="emission_color" type="color3" value="0, 0, 0" />
  </standard_surface>
  <image name="gold_albedotexture_color3" type="color3">
    <input name="file" type="filename" value="renderman/textures/gold_base.png" />
  </image>
  <power name="gold_albedo_linear" type="color3">
    <input name="in1" type="color3" nodename="gold_albedotexture_color3" />
    <input name="in2" type="color3" value="2.2, 2.2, 2.2" />
  </power>
  <multiply name="gold_albedo_factor" type="color3">
    <input name="in1" type="color3" nodename="gold_albedo_linear" />
    <input name="in2" type="color3" value="0.9, 0.618, 0.1" />
  </multiply>
  <image name="gold_metallicroughnesstexture_color3" type="color3">
    <input name="file" type="filename" value="renderman/textures/gold_mat_rgh.png" />
  </image>
  <separate3 name="gold_metallic_roughness_channels" type="multioutput">
    <input name="in" type="color3" nodename="gold_metallicroughnesstexture_color3" />
  </separate3>
  <max name="gold_roughness_minimum" type="float">
    <input name="in1" type="float" nodename="gold_metallic_roughness_channels" output="outy" />
    <input name="in2" type="float" value="0.0316227766017" />
  </max>
  <multiply name="gold_diffuse_roughness" type="float">
    <input name="in1" type="float" nodename="gold_roughness_minimum" />
    <input name="in2" type="float" nodename="gold_roughness_minimum" />
  </multiply>
  <image name="gold_normaltexture_vector3" type="vector3">
    <input name="file" type="filename" value="renderman/textures/gold_normal.png" />
  </image>
  <multiply name="gold_normal_flip" type="vector3">
    <input name="in1" type="vector3" nodename="gold_normaltexture_vector3" />
    <input name="in2" type="vector3" value="1, -1, 1" />
  </multiply>
  <add name="gold_normal_encoded" type="vector3">
    <input name="in1" type="vector3" nodename="gold_normal_flip" />
    <input name="in2" type="vector3" value="0, 1, 0" />
  </add>
  <normalmap name="gold_normal_mapped" type="vector3">
    <input name="in" type="vector3" nodename="gold_normal_encoded" />
  </normalmap>
  <surfacematerial name="gold" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="gold_surface" />
  </surfacematerial>
  <standard_surface name="base_surface" type="surfaceshader">
    <input name="base_color" type="color3" value="0.01, 0.01, 0.01" />
    <input name="metalness" type="float" value="1" />
    <input name="specular_roughness" type="float" value="0.707106781187" />
    <input name="diffuse_roughness" type="float" value="0.5" />
    <input name="transmission_color" type="color3" value="0.01, 0.01, 0.01" />
    <input name="subsurface_color" type="color3" value="0.01, 0.01, 0.01" />
    <input name="coat_roughness" type="float" value="0.316227766017" />
    <input name="emission" type="float" value="1" />
    <input name="emission_color" type="color3" value="0, 0, 0" />
  </standard_surface>
  <surfacematerial name="base" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="base_surface" />
  </surfacematerial>
  <standard_surface name="checker_surface" type="surfaceshader">
    <input name="base_color" type="color3" nodename="checker_albedo_factor" />
    <input name="specular_roughness" type="float" value="0.707106781187" />
    <input name="diffuse_roughness" type="float" value="0.5" />
    <input name="subsurface_color" type="color3" nodename="checker_albedo_factor" />
    <input name="coat_roughness" type="float" value="0.316227766017" />
    <input name="emission" type="float" value="1" />
    <input name="emission_color" type="color3" value="0, 0, 0" />
  </standard_surface>
  <image name="checker_albedotexture_color3" type="color3">
    <input name="file" type="filename" value="renderman/textures/checker.png" />
  </image>
  <power name="checker_albedo_linear" type="color3">
    <input name="in1" type="color3" nodename="checker_albedotexture_color3" />
    <input name="in2" type="color3" value="2.2, 2.2, 2.2" />
  </power>
  <multiply name="checker_albedo_factor" type="color3">
    <input name="in1" type="color3" nodename="checker_albedo_linear" />
    <input name="in2" type="color3" value="1, 1, 1" />
  </multiply>
  <surfacematerial name="checker" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="checker_surface" />
  </surfacematerial>
</materialx>
