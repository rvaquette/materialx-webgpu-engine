<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709" xmlns:engine="urn:materialx-webgpu-engine:extensions">
  <LamaTranslucent name="translucent" type="BSDF">
    <input name="color" type="color3" value="0.65, 0.85, 1" uiname="Color" uifolder="LamaTranslucent" engine:editable="true" />
    <input name="roughness" type="float" value="0.25" uiname="Roughness" uifolder="LamaTranslucent" uimin="0" uimax="1" engine:editable="true" />
  </LamaTranslucent>
  <LamaSurface name="translucent_material" type="material">
    <input name="materialFront" type="BSDF" nodename="translucent" />
    <input name="materialBack" type="BSDF" nodename="translucent" />
    <input name="presence" type="float" value="1" />
  </LamaSurface>
</materialx>
