<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <standard_surface name="ground_surface" type="surfaceshader">
    <input name="base_color" type="color3" value="0.34, 0.34, 0.34" />
    <input name="specular_roughness" type="float" value="0.75" />
    <input name="metalness" type="float" value="0" />
  </standard_surface>
  <surfacematerial name="ground" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="ground_surface" />
  </surfacematerial>

  <LamaDiffuse name="diffuse_control_bsdf" type="BSDF">
    <input name="color" type="color3" value="0.72, 0.28, 0.18" />
    <input name="roughness" type="float" value="0.55" />
    <input name="energyCompensation" type="float" value="1" />
  </LamaDiffuse>
  <LamaSurface name="diffuse_control" type="material">
    <input name="materialFront" type="BSDF" nodename="diffuse_control_bsdf" />
    <input name="materialBack" type="BSDF" nodename="diffuse_control_bsdf" />
    <input name="presence" type="float" value="1" />
  </LamaSurface>

  <LamaSSS name="sss_short_bsdf" type="BSDF">
    <input name="color" type="color3" value="0.72, 0.28, 0.18" />
    <input name="sssRadius" type="color3" value="12, 6, 3" />
    <input name="sssScale" type="float" value="1" />
    <input name="sssUnitLength" type="float" value="0.001" />
    <input name="sssAnisotropy" type="float" value="0.15" />
  </LamaSSS>
  <LamaSurface name="sss_short" type="material">
    <input name="materialFront" type="BSDF" nodename="sss_short_bsdf" />
    <input name="materialBack" type="BSDF" nodename="sss_short_bsdf" />
    <input name="presence" type="float" value="1" />
  </LamaSurface>

  <LamaSSS name="sss_long_bsdf" type="BSDF">
    <input name="color" type="color3" value="0.72, 0.28, 0.18" />
    <input name="sssRadius" type="color3" value="80, 36, 16" />
    <input name="sssScale" type="float" value="1" />
    <input name="sssUnitLength" type="float" value="0.001" />
    <input name="sssAnisotropy" type="float" value="0.35" />
  </LamaSSS>
  <LamaSurface name="sss_long" type="material">
    <input name="materialFront" type="BSDF" nodename="sss_long_bsdf" />
    <input name="materialBack" type="BSDF" nodename="sss_long_bsdf" />
    <input name="presence" type="float" value="1" />
  </LamaSurface>

  <LamaSSS name="sss_coated_base" type="BSDF">
    <input name="color" type="color3" value="0.72, 0.28, 0.18" />
    <input name="sssRadius" type="color3" value="55, 24, 10" />
    <input name="sssScale" type="float" value="1" />
    <input name="sssUnitLength" type="float" value="0.001" />
    <input name="sssAnisotropy" type="float" value="0.2" />
  </LamaSSS>
  <LamaDielectric name="sss_coat_bsdf" type="BSDF">
    <input name="fresnelMode" type="integer" value="1" />
    <input name="IOR" type="float" value="1.45" />
    <input name="roughness" type="float" value="0.08" />
  </LamaDielectric>
  <LamaLayer name="sss_coated_bsdf" type="BSDF">
    <input name="materialTop" type="BSDF" nodename="sss_coat_bsdf" />
    <input name="materialBase" type="BSDF" nodename="sss_coated_base" />
    <input name="topMix" type="float" value="0.45" />
  </LamaLayer>
  <LamaSurface name="sss_coated" type="material">
    <input name="materialFront" type="BSDF" nodename="sss_coated_bsdf" />
    <input name="materialBack" type="BSDF" nodename="sss_coated_bsdf" />
    <input name="presence" type="float" value="1" />
  </LamaSurface>
</materialx>