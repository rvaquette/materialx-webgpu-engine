#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 100
    framesPerSecond = 30
    metersPerUnit = 0.01
    startTimeCode = 0
    subLayers = [
        @materials/eraser.usda@
    ]
    timeCodesPerSecond = 30
    upAxis = "Y"
)

def Xform "World"
{
    over "coloredPencils_grp" (
        prepend references = @coloredPencils_grp.usd@</World/coloredPencils_grp>
    )
    {
        over "group48"
        {
            over "pencil_frntMidLft_grp3FBXASC032eraser_001_mesh"
            {
                uniform token subdivisionScheme = "catmullClark"
            }

            over "eraser_holder_001_mesh6FBXASC032pencil_frntMidLft_grp3"
            {
                uniform token subdivisionScheme = "catmullClark"
            }

            over "pencil_frntMidLft_grp3FBXASC032base_001_mesh"
            {
                uniform token subdivisionScheme = "catmullClark"
            }
        }

        over "group49"
