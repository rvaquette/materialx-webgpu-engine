<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709" xmlns:engine="urn:materialx-webgpu-engine:extensions">
  <LamaDiffuse name="dark_base" type="BSDF">
    <input name="color" type="color3" value="0.015, 0.015, 0.015" engine:editable="false" />
    <input name="roughness" type="float" value="0" />
  </LamaDiffuse>
  <LamaSheen name="sheen" type="BSDF">
    <input name="color" type="color3" value="0.8, 0.15, 0.04" uiname="Color" uifolder="LamaSheen" engine:editable="true" />
    <input name="roughness" type="float" value="0.35" uiname="Roughness" uifolder="LamaSheen" uimin="0" uimax="1" engine:editable="true" />
  </LamaSheen>
  <LamaLayer name="sheen_layer" type="BSDF">
    <input name="materialTop" type="BSDF" nodename="sheen" />
    <input name="materialBase" type="BSDF" nodename="dark_base" />
    <input name="topMix" type="float" value="1" />
  </LamaLayer>
  <LamaSurface name="sheen_material" type="material">
    <input name="materialFront" type="BSDF" nodename="sheen_layer" />
    <input name="materialBack" type="BSDF" nodename="sheen_layer" />
    <input name="presence" type="float" value="1" />
  </LamaSurface>
</materialx>
