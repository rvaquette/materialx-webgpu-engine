    <input name="in2" type="float" value="1.4031" />
  </multiply>
  <multiply name="waveZ1" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="zScaled" />
    <input name="in2" type="float" value="0.9599" />
