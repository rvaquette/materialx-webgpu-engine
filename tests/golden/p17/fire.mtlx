<?xml version="1.0"?>
<materialx version="1.39">
  <position name="position" type="vector3">
    <input name="space" type="string" value="world" />
  </position>
  <separate3 name="coordinates" type="multioutput" nodedef="ND_separate3_vector3">
    <input name="in" type="vector3" nodename="shapePosition" />
  </separate3>
  <separate3 name="flameCenter" type="multioutput" nodedef="ND_separate3_vector3">
    <input name="in" type="vector3" value="0, 0, 0" />
  </separate3>
  <subtract name="relativeX" type="float" nodedef="ND_subtract_float">
    <input name="in1" type="float" nodename="coordinates" output="outx" />
    <input name="in2" type="float" nodename="flameCenter" output="outx" />
  </subtract>
  <subtract name="relativeZ" type="float" nodedef="ND_subtract_float">
    <input name="in1" type="float" nodename="coordinates" output="outz" />
    <input name="in2" type="float" nodename="flameCenter" output="outz" />
  </subtract>
  <multiply name="xSquared" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="relativeX" />
    <input name="in2" type="float" nodename="relativeX" />
  </multiply>
  <multiply name="zSquared" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="relativeZ" />
    <input name="in2" type="float" nodename="relativeZ" />
  </multiply>
  <add name="radialSquared" type="float" nodedef="ND_add_float">
    <input name="in1" type="float" nodename="xSquared" />
    <input name="in2" type="float" nodename="zSquared" />
  </add>
  <sqrt name="radialDistance" type="float">
    <input name="in" type="float" nodename="radialSquared" />
  </sqrt>
  <subtract name="relativeHeight" type="float" nodedef="ND_subtract_float">
    <input name="in1" type="float" nodename="coordinates" output="outy" />
    <input name="in2" type="float" value="1.7" />
  </subtract>
  <time name="clock" type="float" />
  <multiply name="rise" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="clock" />
    <input name="in2" type="float" value="0.7" />
  </multiply>
  <combine3 name="riseOffset" type="vector3" nodedef="ND_combine3_vector3">
    <input name="in1" type="float" value="0" />
    <input name="in2" type="float" nodename="rise" />
    <input name="in3" type="float" value="0" />
  </combine3>
  <subtract name="advectedPosition" type="vector3" nodedef="ND_subtract_vector3">
    <input name="in1" type="vector3" nodename="position" />
    <input name="in2" type="vector3" nodename="riseOffset" />
  </subtract>
  <multiply name="warpPosition" type="vector3" nodedef="ND_multiply_vector3FA">
    <input name="in1" type="vector3" nodename="advectedPosition" />
    <input name="in2" type="float" value="1.2" />
  </multiply>
  <noise3d name="turbulence" type="vector3" nodedef="ND_noise3d_vector3">
    <input name="position" type="vector3" nodename="warpPosition" />
    <input name="amplitude" type="vector3" value="0.65, 0, 0.65" />
  </noise3d>
  <add name="shapePosition" type="vector3" nodedef="ND_add_vector3">
    <input name="in1" type="vector3" nodename="position" />
    <input name="in2" type="vector3" nodename="turbulence" />
  </add>
  <multiply name="scaledPosition" type="vector3" nodedef="ND_multiply_vector3FA">
    <input name="in1" type="vector3" nodename="advectedPosition" />
    <input name="in2" type="float" value="3" />
  </multiply>
  <noise3d name="flameNoise" type="float" nodedef="ND_noise3d_float">
    <input name="position" type="vector3" nodename="scaledPosition" />
    <input name="amplitude" type="float" value="1" />
    <input name="pivot" type="float" value="0" />
  </noise3d>
  <range name="noise01" type="float" nodedef="ND_range_float">
    <input name="in" type="float" nodename="flameNoise" />
    <input name="inlow" type="float" value="-0.12" />
    <input name="inhigh" type="float" value="0.28" />
    <input name="outlow" type="float" value="0" />
    <input name="outhigh" type="float" value="1" />
    <input name="doclamp" type="boolean" value="true" />
  </range>
  <range name="heightFade" type="float" nodedef="ND_range_float">
    <input name="in" type="float" nodename="relativeHeight" />
    <input name="inlow" type="float" value="-1.6" />
    <input name="inhigh" type="float" value="1.6" />
    <input name="outlow" type="float" value="1" />
    <input name="outhigh" type="float" value="0" />
    <input name="doclamp" type="boolean" value="true" />
  </range>
  <range name="radiusByHeight" type="float" nodedef="ND_range_float">
    <input name="in" type="float" nodename="relativeHeight" />
    <input name="inlow" type="float" value="-1.6" />
    <input name="inhigh" type="float" value="1.6" />
    <input name="outlow" type="float" value="1" />
    <input name="outhigh" type="float" value="0.12" />
    <input name="doclamp" type="boolean" value="true" />
  </range>
  <multiply name="radiusAtHeight" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" value="0.8" />
    <input name="in2" type="float" nodename="radiusByHeight" />
  </multiply>
  <divide name="normalizedRadius" type="float" nodedef="ND_divide_float">
    <input name="in1" type="float" nodename="radialDistance" />
    <input name="in2" type="float" nodename="radiusAtHeight" />
  </divide>
  <subtract name="insideFlame" type="float" nodedef="ND_subtract_float">
    <input name="in1" type="float" value="1" />
    <input name="in2" type="float" nodename="normalizedRadius" />
  </subtract>
  <smoothstep name="flameShape" type="float" nodedef="ND_smoothstep_float">
    <input name="in" type="float" nodename="insideFlame" />
    <input name="low" type="float" value="0.05" />
    <input name="high" type="float" value="0.65" />
  </smoothstep>
  <multiply name="heightDensity" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="noise01" />
    <input name="in2" type="float" nodename="heightFade" />
  </multiply>
  <multiply name="flameDensity" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="heightDensity" />
    <input name="in2" type="float" nodename="flameShape" />
  </multiply>
  <multiply name="densityValue" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="flameDensity" />
    <input name="in2" type="float" value="2" />
  </multiply>
  <combine3 name="scatterRgb" type="vector3" nodedef="ND_combine3_vector3">
    <input name="in1" type="float" nodename="densityValue" />
    <input name="in2" type="float" nodename="densityValue" />
    <input name="in3" type="float" nodename="densityValue" />
  </combine3>
  <multiply name="hotter" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="relativeHeight" />
    <input name="in2" type="float" value="-450" />
  </multiply>
  <add name="kelvin" type="float" nodedef="ND_add_float">
    <input name="in1" type="float" value="2400" />
    <input name="in2" type="float" nodename="hotter" />
  </add>
  <blackbody name="fireColor" type="color3">
    <input name="temperature" type="float" nodename="kelvin" />
  </blackbody>
  <multiply name="emissionValue" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="densityValue" />
    <input name="in2" type="float" value="12" />
  </multiply>
  <multiply name="emissionColor" type="color3" nodedef="ND_multiply_color3FA">
    <input name="in1" type="color3" nodename="fireColor" />
    <input name="in2" type="float" nodename="emissionValue" />
  </multiply>
  <uniform_edf name="edf" type="EDF">
    <input name="color" type="color3" nodename="emissionColor" />
  </uniform_edf>
  <anisotropic_vdf name="vdf" type="VDF">
    <input name="absorption" type="vector3" nodename="scatterRgb" />
    <input name="scattering" type="vector3" nodename="scatterRgb" />
    <input name="anisotropy" type="float" value="0.15" />
  </anisotropic_vdf>
  <volume name="fireVolume" type="volumeshader">
    <input name="vdf" type="VDF" nodename="vdf" />
    <input name="edf" type="EDF" nodename="edf" />
  </volume>
  <surfacematerial name="material" type="material" nodedef="ND_engine_volume_material">
    <input name="volumeshader" type="volumeshader" nodename="fireVolume" />
  </surfacematerial>
</materialx>
