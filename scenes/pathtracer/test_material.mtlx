<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <standard_surface name="test_surface" type="surfaceshader">
    <input name="base_color" type="color3" value="0.8, 0, 0" />
    <input name="specular_roughness" type="float" value="0.1" />
    <input name="diffuse_roughness" type="float" value="0.01" />
    <input name="transmission" type="float" value="1" />
    <input name="transmission_color" type="color3" value="0.8, 0, 0" />
    <input name="subsurface_color" type="color3" value="0.8, 0, 0" />
    <input name="coat_roughness" type="float" value="0.316227766017" />
    <input name="specular_color" type="color3" nodename="test_speculartint_mixed" />
    <input name="emission" type="float" value="1" />
    <input name="emission_color" type="color3" value="0, 0, 0" />
  </standard_surface>
  <convert name="test_speculartint_base_vector" type="vector3">
    <input name="in" type="color3" value="0.8, 0, 0" />
  </convert>
  <dotproduct name="test_speculartint_luminance" type="float">
    <input name="in1" type="vector3" nodename="test_speculartint_base_vector" />
    <input name="in2" type="vector3" value="0.3, 0.6, 0.1" />
  </dotproduct>
  <convert name="test_speculartint_luminance_color" type="color3">
    <input name="in" type="float" nodename="test_speculartint_luminance" />
  </convert>
  <max name="test_speculartint_safe" type="color3">
    <input name="in1" type="color3" nodename="test_speculartint_luminance_color" />
    <input name="in2" type="color3" value="0.000001, 0.000001, 0.000001" />
  </max>
  <divide name="test_speculartint_tint" type="color3">
    <input name="in1" type="color3" value="0.8, 0, 0" />
    <input name="in2" type="color3" nodename="test_speculartint_safe" />
  </divide>
  <mix name="test_speculartint_mixed" type="color3">
    <input name="fg" type="color3" nodename="test_speculartint_tint" />
    <input name="bg" type="color3" value="1, 1, 1" />
    <input name="mix" type="float" value="1" />
  </mix>
  <surfacematerial name="test" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="test_surface" />
  </surfacematerial>
  <standard_surface name="ground_surface" type="surfaceshader">
    <input name="base_color" type="color3" value="0.5, 0.5, 0.5" />
    <input name="specular_roughness" type="float" value="0.707106781187" />
    <input name="diffuse_roughness" type="float" value="0.5" />
    <input name="transmission_color" type="color3" value="0.5, 0.5, 0.5" />
    <input name="subsurface_color" type="color3" value="0.5, 0.5, 0.5" />
    <input name="coat_roughness" type="float" value="0.316227766017" />
    <input name="emission" type="float" value="1" />
    <input name="emission_color" type="color3" value="0, 0, 0" />
  </standard_surface>
  <surfacematerial name="ground" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="ground_surface" />
  </surfacematerial>
</materialx>
