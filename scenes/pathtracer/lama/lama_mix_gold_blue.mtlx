<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709" xmlns:engine="urn:materialx-webgpu-engine:extensions">
  <LamaConductor name="gold" type="BSDF">
    <input name="fresnelMode" type="integer" value="1" />
    <input name="IOR" type="vector3" value="0.18, 0.42, 1.37" />
    <input name="extinction" type="vector3" value="3.42, 2.35, 1.77" />
    <input name="roughness" type="float" value="0.24" uimin="0" uimax="1" engine:editable="true" />
    <input name="tint" type="color3" value="1, 1, 1" />
  </LamaConductor>
  <LamaDiffuse name="blue" type="BSDF">
    <input name="color" type="color3" value="0.025, 0.12, 0.48" />
    <input name="roughness" type="float" value="0.4" />
  </LamaDiffuse>
  <LamaMix name="gold_blue_mix" type="BSDF">
    <input name="material1" type="BSDF" nodename="gold" />
    <input name="material2" type="BSDF" nodename="blue" />
    <input name="mix" type="float" value="0.5" uimin="0" uimax="1" engine:editable="true" />
  </LamaMix>
  <LamaSurface name="gold_blue" type="material">
    <input name="materialFront" type="BSDF" nodename="gold_blue_mix" />
    <input name="materialBack" type="BSDF" nodename="gold_blue_mix" />
    <input name="presence" type="float" value="1" />
  </LamaSurface>
</materialx>