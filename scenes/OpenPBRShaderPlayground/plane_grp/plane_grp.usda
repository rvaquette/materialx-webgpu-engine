#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 100
    framesPerSecond = 30
    metersPerUnit = 0.01
    startTimeCode = 0
    subLayers = [
        @materials/bottle.usda@,
        @materials/hotglue.usda@,
        @materials/pacifier.usda@,
        @materials/pencil.usda@,
        @materials/planePlastic.usda@,
        @materials/wings.usda@
    ]
    timeCodesPerSecond = 30
    upAxis = "Y"
)

