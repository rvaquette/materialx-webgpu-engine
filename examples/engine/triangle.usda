#usda 1.0
(
    defaultPrim = "World"
    upAxis = "Y"
)

def Xform "World"
{
    def Camera "Camera"
    {
        double3 xformOp:translate = (0, 0, 4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Mesh "Triangle"
    {
        rel material:binding = </World/Matte>
        int[] faceVertexCounts = [3]
        int[] faceVertexIndices = [0, 1, 2]
        point3f[] points = [(-1, -0.75, 0), (1, -0.75, 0), (0, 1, 0)]
        uniform token subdivisionScheme = "none"
        uniform bool doubleSided = true
    }

    def Material "Matte"
    {
        token outputs:surface.connect = </World/Matte/Surface.outputs:surface>
        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.18, 0.55, 0.8)
            float inputs:roughness = 0.6
            token outputs:surface
        }
    }
}
