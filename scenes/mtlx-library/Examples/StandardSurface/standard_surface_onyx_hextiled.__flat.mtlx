<?xml version="1.0"?>
<materialx version="1.39">
  <convert name="tiling_vector2" type="vector2" nodedef="ND_convert_float_vector2">
    <input name="in" type="float" value="4" />
  </convert>
  <hextiledimage name="image_color" type="color3">
    <input name="file" type="filename" value="../../showcase/standard_surface/onyx_hextiled/textures/onyx_color.jpg" colorspace="srgb_texture" />
    <input name="tiling" type="vector2" nodename="tiling_vector2" />
    <input name="rotation" type="float" value="1" />
    <input name="scale" type="float" value="1" />
    <input name="offset" type="float" value="1" />
    <input name="falloff" type="float" value="0.75" />
  </hextiledimage>
  <hextiledimage name="image_roughness" type="color3">
    <input name="file" type="filename" value="../../showcase/standard_surface/onyx_hextiled/textures/onyx_roughness.jpg" colorspace="none" />
    <input name="tiling" type="vector2" nodename="tiling_vector2" />
    <input name="rotation" type="float" value="1" />
    <input name="scale" type="float" value="1" />
    <input name="offset" type="float" value="1" />
    <input name="falloff" type="float" value="0.75" />
  </hextiledimage>
  <extract name="image_roughness_float" type="float">
    <input name="in" type="color3" nodename="image_roughness" />
    <input name="index" type="integer" value="0" />
  </extract>
  <standard_surface name="N_StandardSurface" type="surfaceshader">
    <input name="base_color" type="color3" nodename="image_color" />
    <input name="specular_roughness" type="float" nodename="image_roughness_float" />
  </standard_surface>
  <surfacematerial name="M_OnyxHextiled" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="N_StandardSurface" />
  </surfacematerial>
</materialx>
