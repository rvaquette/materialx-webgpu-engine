<?xml version="1.0"?>
<materialx version="1.39">
  <position name="position" type="vector3">
    <input name="space" type="string" value="object" />
  </position>
  <separate3 name="coordinates" type="multioutput" nodedef="ND_separate3_vector3">
    <input name="in" type="vector3" nodename="position" />
  </separate3>
  <time name="clock" type="float" />
  <multiply name="phase" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="clock" />
    <input name="in2" type="float" value="0.5" />
  </multiply>
  <multiply name="xScaled" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="coordinates" output="outx" />
    <input name="in2" type="float" value="1.5" />
  </multiply>
  <multiply name="zScaled" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="coordinates" output="outz" />
    <input name="in2" type="float" value="1.5" />
  </multiply>
  <add name="xPhase" type="float" nodedef="ND_add_float">
    <input name="in1" type="float" nodename="xScaled" />
    <input name="in2" type="float" nodename="phase" />
  </add>
  <multiply name="zFrequency" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="zScaled" />
    <input name="in2" type="float" value="1.7" />
  </multiply>
  <multiply name="zTime" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="phase" />
    <input name="in2" type="float" value="1.3" />
  </multiply>
  <add name="zPhase" type="float" nodedef="ND_add_float">
    <input name="in1" type="float" nodename="zFrequency" />
    <input name="in2" type="float" nodename="zTime" />
  </add>
  <sin name="xWave" type="float">
    <input name="in" type="float" nodename="xPhase" />
  </sin>
  <sin name="zWave" type="float">
    <input name="in" type="float" nodename="zPhase" />
  </sin>
  <multiply name="smallWave" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="zWave" />
    <input name="in2" type="float" value="0.45" />
  </multiply>
  <add name="largeWaves" type="float" nodedef="ND_add_float">
    <input name="in1" type="float" nodename="xWave" />
    <input name="in2" type="float" nodename="smallWave" />
  </add>
  <multiply name="crossX" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="xScaled" />
    <input name="in2" type="float" value="2.3" />
  </multiply>
  <multiply name="crossZ" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="zScaled" />
    <input name="in2" type="float" value="-1.7" />
  </multiply>
  <add name="crossPosition" type="float" nodedef="ND_add_float">
    <input name="in1" type="float" nodename="crossX" />
    <input name="in2" type="float" nodename="crossZ" />
  </add>
  <multiply name="crossTime" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="phase" />
    <input name="in2" type="float" value="1.9" />
  </multiply>
  <add name="crossPhase" type="float" nodedef="ND_add_float">
    <input name="in1" type="float" nodename="crossPosition" />
    <input name="in2" type="float" nodename="crossTime" />
  </add>
  <sin name="crossWave" type="float">
    <input name="in" type="float" nodename="crossPhase" />
  </sin>
  <multiply name="crossAmplitude" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="crossWave" />
    <input name="in2" type="float" value="0.18" />
  </multiply>
  <add name="waveSum" type="float" nodedef="ND_add_float">
    <input name="in1" type="float" nodename="largeWaves" />
    <input name="in2" type="float" nodename="crossAmplitude" />
  </add>
  <multiply name="waveHeightValue" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="waveSum" />
    <input name="in2" type="float" value="0.12" />
  </multiply>
  <displacement name="waveDisplacement" type="displacementshader">
    <input name="displacement" type="float" nodename="waveHeightValue" />
  </displacement>
  <smoothstep name="foamMask" type="float" nodedef="ND_smoothstep_float">
    <input name="in" type="float" nodename="waveSum" />
    <input name="low" type="float" value="0.7" />
    <input name="high" type="float" value="1.1" />
  </smoothstep>
  <mix name="surfaceColor" type="color3">
    <input name="fg" type="color3" value="0.8, 0.92, 0.9" />
    <input name="bg" type="color3" value="0.025, 0.16, 0.2" />
    <input name="mix" type="float" nodename="foamMask" />
  </mix>
  <combine3 name="detailOffset" type="vector3" nodedef="ND_combine3_vector3">
    <input name="in1" type="float" nodename="phase" />
    <input name="in2" type="float" value="0" />
    <input name="in3" type="float" nodename="crossTime" />
  </combine3>
  <add name="detailPosition" type="vector3" nodedef="ND_add_vector3">
    <input name="in1" type="vector3" nodename="position" />
    <input name="in2" type="vector3" nodename="detailOffset" />
  </add>
  <multiply name="detailScale" type="vector3" nodedef="ND_multiply_vector3">
    <input name="in1" type="vector3" nodename="detailPosition" />
    <input name="in2" type="vector3" value="8, 8, 8" />
  </multiply>
  <noise3d name="detailNoise" type="float" nodedef="ND_noise3d_float">
    <input name="position" type="vector3" nodename="detailScale" />
    <input name="amplitude" type="float" value="1" />
    <input name="pivot" type="float" value="0" />
  </noise3d>
  <bump name="detailNormal" type="vector3">
    <input name="height" type="float" nodename="detailNoise" />
    <input name="scale" type="float" value="0.025" />
  </bump>
  <subtract name="transmissionWeight" type="float" nodedef="ND_subtract_float">
    <input name="in1" type="float" value="1" />
    <input name="in2" type="float" nodename="foamMask" />
  </subtract>
  <mix name="waterRoughness" type="float" nodedef="ND_mix_float">
    <input name="fg" type="float" value="0.4" />
    <input name="bg" type="float" value="0.08" />
    <input name="mix" type="float" nodename="foamMask" />
  </mix>
  <standard_surface name="waterSurface" type="surfaceshader">
    <input name="base" type="float" nodename="foamMask" />
    <input name="base_color" type="color3" nodename="surfaceColor" />
    <input name="specular_roughness" type="float" nodename="waterRoughness" />
    <input name="specular_IOR" type="float" value="1.333" />
    <input name="transmission" type="float" nodename="transmissionWeight" />
    <input name="transmission_color" type="color3" value="0.015, 0.08, 0.12" />
    <input name="transmission_depth" type="float" value="2" />
    <input name="normal" type="vector3" nodename="detailNormal" />
  </standard_surface>
  <surfacematerial name="material" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="waterSurface" />
    <input name="displacementshader" type="displacementshader" nodename="waveDisplacement" />
  </surfacematerial>
</materialx>
