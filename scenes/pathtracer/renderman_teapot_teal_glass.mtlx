<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <standard_surface name="teal_glass_surface" type="surfaceshader">
    <input name="base_color" type="color3" value="1, 1, 1" />
    <input name="specular_roughness" type="float" value="0.141421356237" />
    <input name="diffuse_roughness" type="float" value="0.02" />
    <input name="transmission" type="float" value="1" />
    <input name="transmission_color" type="color3" value="0.400516626091, 0.92035114722, 0.858988280741" />
    <input name="transmission_depth" type="float" value="0.01" />
    <input name="coat_roughness" type="float" value="0.316227766017" />
    <input name="emission" type="float" value="1" />
    <input name="emission_color" type="color3" value="0, 0, 0" />
  </standard_surface>
  <surfacematerial name="teal_glass" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="teal_glass_surface" />
  </surfacematerial>
  <standard_surface name="base_surface" type="surfaceshader">
    <input name="base_color" type="color3" value="0.01, 0.01, 0.01" />
    <input name="metalness" type="float" value="1" />
    <input name="specular_roughness" type="float" value="0.707106781187" />
    <input name="diffuse_roughness" type="float" value="0.5" />
    <input name="transmission_color" type="color3" value="0.01, 0.01, 0.01" />
    <input name="subsurface_color" type="color3" value="0.01, 0.01, 0.01" />
    <input name="coat_roughness" type="float" value="0.316227766017" />
    <input name="emission" type="float" value="1" />
    <input name="emission_color" type="color3" value="0, 0, 0" />
  </standard_surface>
  <surfacematerial name="base" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="base_surface" />
  </surfacematerial>
  <standard_surface name="checker_surface" type="surfaceshader">
    <input name="base_color" type="color3" nodename="checker_albedo_factor" />
    <input name="specular_roughness" type="float" value="0.707106781187" />
    <input name="diffuse_roughness" type="float" value="0.5" />
    <input name="subsurface_color" type="color3" nodename="checker_albedo_factor" />
    <input name="coat_roughness" type="float" value="0.316227766017" />
    <input name="emission" type="float" value="1" />
    <input name="emission_color" type="color3" value="0, 0, 0" />
  </standard_surface>
  <image name="checker_albedotexture_color3" type="color3">
    <input name="file" type="filename" value="renderman/textures/checker.png" />
  </image>
  <power name="checker_albedo_linear" type="color3">
    <input name="in1" type="color3" nodename="checker_albedotexture_color3" />
    <input name="in2" type="color3" value="2.2, 2.2, 2.2" />
  </power>
  <multiply name="checker_albedo_factor" type="color3">
    <input name="in1" type="color3" nodename="checker_albedo_linear" />
    <input name="in2" type="color3" value="1, 1, 1" />
  </multiply>
  <surfacematerial name="checker" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="checker_surface" />
  </surfacematerial>
</materialx>
