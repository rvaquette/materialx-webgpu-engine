renderer
{
    resolution 1280 720
    maxdepth 8
    tilewidth 256
    tileheight 144
    enabletonemap false
}

camera
{
    position 7.5 5 7
    lookat 0 0 0
    fov 45
}

material onyx_hextiled
{
    materialx_document ../materialx/materials/Examples/StandardSurface/standard_surface_onyx_hextiled.mtlx
    materialx_surface M_OnyxHextiled
}

material ground
{
    color 0.50 0.50 0.50
    roughness 0.55
    metallic 0.0
}

mesh
{
    name cube_onyx
    file material_test/cube.obj
    material onyx_hextiled
}

mesh
{
    name ground
    file material_test/floor.obj
    material ground
}

light
{
    emission 5.0 5.0 5.0
    position 1 5 1
    radius 1.0
    type sphere
}

light
{
    emission 3.125 3.125 3.125
    position -3.500000 2.500000 0.500000
    v2 -1.500000 2.500000 0.500000
    v1 -3.500000 2.500000 -1.500000
    type quad
}
