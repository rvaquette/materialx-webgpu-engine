#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    startTimeCode = 0
    endTimeCode = 48
    timeCodesPerSecond = 24
    doc = "Dynamic-scene control: animated hierarchy, deforming mesh, light, visibility, camera and a material variant."
)

def Xform "World"
{
    custom string pathtracer:sourceScene = "animated"
    custom int pathtracer:maxDepth = 4

    def Camera "Camera"
    {
        double3 xformOp:translate.timeSamples = { 0: (0, 3, 12), 48: (3, 4, 9) }
        float xformOp:rotateY.timeSamples = { 0: 0, 48: 18 }
        float xformOp:rotateX = -12
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateY", "xformOp:rotateX"]
        float focalLength = 35
        float horizontalAperture = 36
        float verticalAperture = 36
        float2 clippingRange = (0.01, 1000)
    }

    def Scope "Looks"
    {
        def Material "white" (
            prepend references = @../pathtracer/test_veach.mtlx@</MaterialX/Materials/white>
        )
        {
        }
        def Material "metal" (
            prepend references = @../pathtracer/test_veach.mtlx@</MaterialX/Materials/metal_2>
        )
        {
        }
    }

    def Mesh "Floor"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(-10, 0, 10), (10, 0, 10), (10, 0, -10), (-10, 0, -10)]
        rel material:binding = </World/Looks/white>
    }

    def Xform "Rig"
    {
        double3 xformOp:translate.timeSamples = { 0: (-3, 0, 0), 48: (3, 0, 0) }
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Mesh "Cube" (
            variants = {
                string finish = "white"
            }
            prepend variantSets = "finish"
        )
        {
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 2, 3, 1, 4, 5, 7, 6, 0, 1, 5, 4, 2, 6, 7, 3, 0, 4, 6, 2, 1, 3, 7, 5]
            point3f[] points = [(-1, 0, -1), (1, 0, -1), (-1, 2, -1), (1, 2, -1), (-1, 0, 1), (1, 0, 1), (-1, 2, 1), (1, 2, 1)]
            float xformOp:rotateY.timeSamples = { 0: 0, 48: 180 }
            uniform token[] xformOpOrder = ["xformOp:rotateY"]
            variantSet "finish" = {
                "white" {
                    rel material:binding = </World/Looks/white>
                }
                "metal" {
                    rel material:binding = </World/Looks/metal>
                }
            }
        }
    }

    def Mesh "Wave"
