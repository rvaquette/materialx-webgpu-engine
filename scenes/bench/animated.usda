        }
        double3 xformOp:translate = (0, 0.05, 4)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Looks/metal>
    }

    def Mesh "Blinker"
    {
        int[] faceVertexCounts = [4]
        int[] faceVertexIndices = [0, 1, 2, 3]
        point3f[] points = [(4, 0.5, -3), (6, 0.5, -3), (6, 2.5, -3), (4, 2.5, -3)]
        token visibility.timeSamples = { 0: "inherited", 24: "invisible" }
        rel material:binding = </World/Looks/white>
    }

    def Scope "Lights"
    {
        def SphereLight "Key"
        {
            double3 xformOp:translate.timeSamples = { 0: (-4, 6, 4), 48: (4, 6, 4) }
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f inputs:color = (1, 0.9, 0.8)
            float inputs:intensity.timeSamples = { 0: 30, 48: 60 }
            bool inputs:normalize = false
            float inputs:radius = 0.5
        }
        def SphereLight "Fill"
        {
            double3 xformOp:translate = (6, 8, -6)
            uniform token[] xformOpOrder = ["xformOp:translate"]
            color3f inputs:color = (0.6, 0.7, 1)
            float inputs:intensity = 10
            bool inputs:normalize = false
            float inputs:radius = 1
        }
