{
  "name": "materialx-webgpu-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "WebGPU rendering engine for OpenUSD scenes with a TypeScript MaterialX compiler.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:device": "node scripts/run-device-corpus.mjs",
    "build:fixtures": "node scripts/build-shaderball-fixture.mjs && node scripts/build-scene-materials.mjs",
    "build:materials": "node scripts/build-scene-materials.mjs"
  },
  "dependencies": {
    "comlink": "4.4.2",
    "idb": "8.0.1",
    "wgpu-matrix": "3.4.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "@webgpu/types": "0.1.60",
    "three": "^0.186.1",
    "typescript": "5.7.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
