{
  "name": "materialx-webgpu-engine",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "WebGPU rendering engine for OpenUSD scenes with a TypeScript MaterialX compiler.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:materialx-core:minimal",
    "build:static": "tsc --noEmit && vite build && node scripts/package-static.mjs",
    "build:materialx-core:minimal": "node scripts/build-materialx-core-minimal.mjs",
    "bench:materialx-core": "node scripts/bench-materialx-core-build.mjs",
    "build:shaderball": "tsc --noEmit && node scripts/build-shaderball.mjs",
    "build:engine-package": "node scripts/build-engine-package.mjs",
    "test:engine-package": "npm run build:engine-package && node --test scripts/test-engine-package.mjs",
    "api:engine": "node scripts/engine-api.mjs",
    "render:engine": "node scripts/render-engine.mjs",
    "render:remote": "node scripts/remote-render-server.mjs",
    "bench:engine": "node scripts/bench-engine.mjs",
    "preview": "vite preview",
    "script": "node scripts/run-material-script.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test scripts/*.test.mjs",
    "test:watch": "vitest",
    "test:playwright": "playwright test --project=chromium",
    "test:playwright:demo": "playwright test --project=demo",
    "test:playwright:android": "playwright test --project=android",
    "test:playwright:browsers": "playwright test engine-smoke --project=chromium --project=chrome --project=firefox --project=webkit",
    "test:golden": "node scripts/golden.mjs",
    "test:gpu-matrix": "node scripts/test-gpu-matrix.mjs",
    "bench:streaming": "node scripts/bench-streaming.mjs",
    "test:headless-capture": "node --test scripts/test-headless-capture.mjs",
    "test:local-gpu": "node scripts/run-local-corpus.mjs",
    "test:local-scene": "node scripts/run-local-scene.mjs",
    "test:local-bxdf": "node scripts/run-local-bxdf.mjs",
    "test:device": "node scripts/run-device-corpus.mjs",
    "test:scene-device": "node scripts/run-scene-device.mjs",
    "test:bxdf-device": "node scripts/run-bxdf-device.mjs",
    "audit:mtlx": "node scripts/audit-mtlx-compilation.mjs",
    "test:shaderball": "node scripts/run-shaderball-renders.mjs",
    "render:usd-matrix": "node scripts/run-usd-matrix-local.mjs",
    "build:fixtures": "node scripts/build-shaderball-fixture.mjs && node scripts/build-scene-materials.ts",
    "build:materials": "node scripts/build-scene-materials.ts",
    "export:scene": "node scripts/export-scene.mjs",
    "compile:scenes": "node scripts/compile-scenes.mjs",
    "render:scenes": "node scripts/render-scenes.ts",
    "validate:scene": "vite-node scripts/validate-disney-gold.ts"
  },
  "dependencies": {
    "@bokuweb/zstd-wasm": "0.0.27",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@comfyorg/litegraph": "0.17.2",
    "@mori2003/jsimgui": "0.14.0",
    "acorn": "^8.19.0",
    "codemirror": "^6.0.2",
    "comlink": "4.4.2",
    "dockview-core": "^8.9.1",
    "idb": "8.0.1",
    "three": "^0.186.1",
    "wgpu-matrix": "3.4.0"
  },
  "devDependencies": {
    "@needle-tools/usd": "^1.1.2",
    "@playwright/test": "^1.65.1",
    "@types/three": "^0.186.0",
    "@webgpu/types": "0.1.60",
    "typescript": "5.7.2",
    "vite": "8.3.4",
    "vite-node": "^6.0.0",
    "vitest": "5.0.3"
  }
}
