    <input name="specular_roughness" type="float" nodename="body_roughness_minimum" />
    <input name="diffuse_roughness" type="float" nodename="body_diffuse_roughness" />
    <input name="subsurface_color" type="color3" nodename="body_albedo_factor" />
    <input name="coat_roughness" type="float" value="0.316227766017" />
    <input name="normal" type="vector3" nodename="body_normal_mapped" />
    <input name="emission" type="float" value="1" />
    <input name="emission_color" type="color3" value="0, 0, 0" />
