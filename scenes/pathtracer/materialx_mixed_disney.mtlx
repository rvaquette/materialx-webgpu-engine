<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <disney_principled name="disney_red_surface" type="surfaceshader">
    <input name="baseColor" type="color3" value="0.8, 0.1, 0.1" />
    <input name="metallic" type="float" value="1" />
    <input name="roughness" type="float" value="0.25" />
  </disney_principled>
  <surfacematerial name="disney_red" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="disney_red_surface" />
  </surfacematerial>
  <!-- source MaterialX: ../materialx/materials/Examples/StandardSurface/standard_surface_brass_tiled.mtlx; surface: Tiled_Brass; converted to DisneyPrincipled -->
  <disney_principled name="brass_tiled_surface" type="surfaceshader">
    <input name="baseColor" type="color3" value="0.8, 0.8, 0.8" />
  </disney_principled>
  <surfacematerial name="brass_tiled" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="brass_tiled_surface" />
  </surfacematerial>
  <disney_principled name="ground_surface" type="surfaceshader">
    <input name="baseColor" type="color3" value="0.5, 0.5, 0.5" />
    <input name="metallic" type="float" value="0" />
    <input name="roughness" type="float" value="0.55" />
  </disney_principled>
  <surfacematerial name="ground" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="ground_surface" />
  </surfacematerial>
</materialx>
