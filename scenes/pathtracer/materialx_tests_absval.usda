#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    doc = "materialx_tests_absval converted from GLSL-PathTracer .scene"
)

def Xform "World"
{
    custom string pathtracer:sourceScene = "materialx_tests_absval.scene"
    custom int2 pathtracer:resolution = (1280, 720)
    custom int pathtracer:maxDepth = 8
    custom float pathtracer:environmentIntensity = 4
    custom asset pathtracer:environment = @./HDR/san_giuseppe_bridge_split.hdr@

    def Camera "Camera"
    {
        matrix4d xformOp:transform = ((0.68231825036, 0, -0.731055268243, 0), (-0.320281128078, 0.898922366139, -0.298929052873, 0), (0.657161931507, 0.438107954338, 0.613351136074, 0), (7.5, 5, 7, 1))
        uniform token[] xformOpOrder = ["xformOp:transform"]
        token projection = "perspective"
        float focalLength = 50
        float horizontalAperture = 41.4213562373
        float verticalAperture = 23.2995128835
        float2 clippingRange = (0.001, 1000000)
        custom point3f pathtracer:lookAt = (0, 0, 0)
        custom float pathtracer:fov = 45
    }

    def Scope "Looks"
    {
        def Material "mtlx_test" (
            prepend references = @./materialx_tests_absval.mtlx@</MaterialX/Materials/mtlx_test>
        )
        {
        }
    }

    def Scope "Geometry"
    {
        def Mesh "cube"
        {
            custom asset engine:geometry:file = @./material_test/cube.obj@

            rel material:binding = </World/Looks/mtlx_test>
        }
        def Mesh "sphere"
        {
            custom asset engine:geometry:file = @./material_test/sphere.obj@

            rel material:binding = </World/Looks/mtlx_test>
        }
        def Mesh "ground"
        {
            custom asset engine:geometry:file = @./material_test/floor.obj@

            rel material:binding = </World/Looks/mtlx_test>
        }
    }

    def Scope "Lights"
    {
        def DomeLight "Environment"
        {
            asset inputs:texture:file = @./HDR/san_giuseppe_bridge_split.hdr@
            float inputs:intensity = 4
            color3f inputs:color = (1, 1, 1)
            float xformOp:rotateY = -90
            uniform token[] xformOpOrder = ["xformOp:rotateY"]
        }
    }
}
