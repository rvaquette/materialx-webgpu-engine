    <input name="in2" type="float" nodename="waveZ1" />
  </add>
  <multiply name="waveTime1" type="float" nodedef="ND_multiply_float">
    <input name="in1" type="float" nodename="phase" />
    <input name="in2" type="float" value="1.8254" />
  </multiply>
  <add name="wavePhase1" type="float" nodedef="ND_add_float">
    <input name="in1" type="float" nodename="waveSpace1" />
    <input name="in2" type="float" nodename="waveTime1" />
  </add>
  <sin name="waveSine1" type="float">
