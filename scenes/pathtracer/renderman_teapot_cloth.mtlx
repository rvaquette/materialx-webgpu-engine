<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <standard_surface name="marble_surface" type="surfaceshader">
    <input name="base_color" type="color3" nodename="marble_albedo_factor" />
    <input name="metalness" type="float" nodename="marble_metallic_roughness_channels" output="outz" />
    <input name="specular_roughness" type="float" nodename="marble_roughness_minimum" />
    <input name="diffuse_roughness" type="float" nodename="marble_diffuse_roughness" />
    <input name="subsurface_color" type="color3" nodename="marble_albedo_factor" />
    <input name="coat_roughness" type="float" value="0.316227766017" />
    <input name="emission" type="float" value="1" />
    <input name="emission_color" type="color3" value="0, 0, 0" />
  </standard_surface>
  <image name="marble_albedotexture_color3" type="color3">
    <input name="file" type="filename" value="renderman/textures/marble_base.png" />
  </image>
  <power name="marble_albedo_linear" type="color3">
    <input name="in1" type="color3" nodename="marble_albedotexture_color3" />
    <input name="in2" type="color3" value="2.2, 2.2, 2.2" />
  </power>
  <multiply name="marble_albedo_factor" type="color3">
    <input name="in1" type="color3" nodename="marble_albedo_linear" />
    <input name="in2" type="color3" value="1, 1, 1" />
  </multiply>
  <image name="marble_metallicroughnesstexture_color3" type="color3">
    <input name="file" type="filename" value="renderman/textures/marble_mat_rgh.png" />
  </image>
  <separate3 name="marble_metallic_roughness_channels" type="multioutput">
    <input name="in" type="color3" nodename="marble_metallicroughnesstexture_color3" />
  </separate3>
  <max name="marble_roughness_minimum" type="float">
    <input name="in1" type="float" nodename="marble_metallic_roughness_channels" output="outy" />
    <input name="in2" type="float" value="0.0316227766017" />
  </max>
  <multiply name="marble_diffuse_roughness" type="float">
    <input name="in1" type="float" nodename="marble_roughness_minimum" />
    <input name="in2" type="float" nodename="marble_roughness_minimum" />
  </multiply>
  <surfacematerial name="marble" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="marble_surface" />
  </surfacematerial>
  <standard_surface name="purple_cloth_surface" type="surfaceshader">
    <input name="base_color" type="color3" value="0.073, 0.01, 0.25" />
    <input name="specular_roughness" type="float" value="1" />
    <input name="diffuse_roughness" type="float" value="1" />
    <input name="transmission_color" type="color3" value="0.073, 0.01, 0.25" />
    <input name="subsurface_color" type="color3" value="0.073, 0.01, 0.25" />
    <input name="coat_roughness" type="float" value="0.316227766017" />
    <input name="sheen" type="float" value="1" />
    <input name="emission" type="float" value="1" />
    <input name="emission_color" type="color3" value="0, 0, 0" />
  </standard_surface>
  <surfacematerial name="purple_cloth" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="purple_cloth_surface" />
  </surfacematerial>
  <standard_surface name="base_surface" type="surfaceshader">
    <input name="base_color" type="color3" value="0.01, 0.01, 0.01" />
    <input name="metalness" type="float" value="1" />
    <input name="specular_roughness" type="float" value="0.707106781187" />
    <input name="diffuse_roughness" type="float" value="0.5" />
    <input name="transmission_color" type="color3" value="0.01, 0.01, 0.01" />
    <input name="subsurface_color" type="color3" value="0.01, 0.01, 0.01" />
    <input name="coat_roughness" type="float" value="0.316227766017" />
    <input name="emission" type="float" value="1" />
    <input name="emission_color" type="color3" value="0, 0, 0" />
  </standard_surface>
  <surfacematerial name="base" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="base_surface" />
  </surfacematerial>
  <standard_surface name="checker_surface" type="surfaceshader">
    <input name="base_color" type="color3" nodename="checker_albedo_factor" />
    <input name="specular_roughness" type="float" value="0.707106781187" />
    <input name="diffuse_roughness" type="float" value="0.5" />
    <input name="subsurface_color" type="color3" nodename="checker_albedo_factor" />
    <input name="coat_roughness" type="float" value="0.316227766017" />
    <input name="emission" type="float" value="1" />
    <input name="emission_color" type="color3" value="0, 0, 0" />
  </standard_surface>
  <image name="checker_albedotexture_color3" type="color3">
    <input name="file" type="filename" value="renderman/textures/checker.png" />
  </image>
  <power name="checker_albedo_linear" type="color3">
    <input name="in1" type="color3" nodename="checker_albedotexture_color3" />
    <input name="in2" type="color3" value="2.2, 2.2, 2.2" />
  </power>
  <multiply name="checker_albedo_factor" type="color3">
    <input name="in1" type="color3" nodename="checker_albedo_linear" />
    <input name="in2" type="color3" value="1, 1, 1" />
  </multiply>
  <surfacematerial name="checker" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="checker_surface" />
  </surfacematerial>
</materialx>
