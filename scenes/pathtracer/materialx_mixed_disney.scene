// Scène de démonstration : matériaux mixtes Disney + MaterialX (feature 002).
// L'objet de gauche utilise un matériau Disney (paramètres du .scene) ; l'objet
// de droite utilise un matériau MaterialX (document .mtlx). Le path tracer
// aiguille chaque objet vers le bon modèle d'ombrage au moment de l'exécution.
renderer
{
    resolution 1280 720
    maxdepth 8
    tilewidth 256
    tileheight 144
    enabletonemap false
}

camera
{
    position 7.5 5 7
    lookat 0 0 0
    fov 45
}

// Matériau Disney (implémentation intégrée du path tracer)
material disney_red
{
    color 0.80 0.10 0.10
    roughness 0.25
    metallic 1.0
}

// Matériau MaterialX (dérivé d'un document .mtlx)
material brass_tiled
{
    materialx_document ../materialx/materials/Examples/StandardSurface/standard_surface_brass_tiled.mtlx
    materialx_surface Tiled_Brass
}

// Sol : matériau Disney neutre
material ground
{
    color 0.50 0.50 0.50
    roughness 0.55
    metallic 0.0
}

mesh
{
    name cube_disney
    file material_test/cube.obj
    material disney_red
    position -1.6 0 0
}

mesh
{
    name cube_materialx
    file material_test/cube.obj
    material brass_tiled
    position 1.6 0 0
}

mesh
{
    name ground
    file material_test/floor.obj
    material ground
}

light
{
    emission 5.0 5.0 5.0
    position 1 5 1
    radius 1.0
    type sphere
}

light
{
    emission 3.125 3.125 3.125
    position -3.500000 2.500000 0.500000
    v2 -1.500000 2.500000 0.500000
    v1 -3.500000 2.500000 -1.500000
    type quad
}
