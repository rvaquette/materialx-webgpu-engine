<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <disney_principled name="volume_surface" type="surfaceshader">
    <input name="baseColor" type="color3" value="1, 1, 1" />
    <input name="roughness" type="float" value="0" />
    <input name="specTrans" type="float" value="1" />
  </disney_principled>
  <surfacematerial name="volume" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="volume_surface" />
  </surfacematerial>
  <disney_principled name="black_surface" type="surfaceshader">
    <input name="baseColor" type="color3" value="0.1, 0.1, 0.1" />
    <input name="roughness" type="float" value="0.5" />
  </disney_principled>
  <surfacematerial name="black" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="black_surface" />
  </surfacematerial>
</materialx>
