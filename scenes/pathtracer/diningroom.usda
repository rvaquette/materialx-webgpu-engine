#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    doc = "diningroom converted from GLSL-PathTracer .scene"
)

def Xform "World"
{
    custom string pathtracer:sourceScene = "diningroom.scene"
    custom int2 pathtracer:resolution = (1280, 720)
    custom int pathtracer:maxDepth = 3

    def Camera "Camera"
    {
        matrix4d xformOp:transform = ((0, 0, 1, 0), (0.175033334717, 0.984562507786, 0, 0), (-0.984562507786, 0.175033334717, 0, 0), (-4.5, 1.6, 0, 1))
        uniform token[] xformOpOrder = ["xformOp:transform"]
        token projection = "perspective"
        float focalLength = 50
        float horizontalAperture = 57.735026919
        float verticalAperture = 32.4759526419
        float2 clippingRange = (0.001, 1000000)
        custom point3f pathtracer:lookAt = (0, 0.8, 0)
        custom float pathtracer:fov = 60
    }

