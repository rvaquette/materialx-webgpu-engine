<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <standard_surface name="ground_surface" type="surfaceshader">
    <input name="base_color" type="color3" value="0.3, 0.3, 0.3" />
    <input name="specular_roughness" type="float" value="0.8" />
  </standard_surface>
  <surfacematerial name="ground" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="ground_surface" />
  </surfacematerial>

  <LamaConductor name="gold_bsdf" type="BSDF">
    <input name="fresnelMode" type="integer" value="1" />
    <input name="IOR" type="vector3" value="0.18, 0.42, 1.37" />
    <input name="extinction" type="vector3" value="3.42, 2.35, 1.77" />
    <input name="roughness" type="float" value="0.18" />
    <input name="anisotropy" type="float" value="0.35" />
    <input name="anisotropyDirection" type="vector3" value="0, 1, 0" />
    <input name="tint" type="color3" value="1, 0.92, 0.7" />
  </LamaConductor>
  <LamaSurface name="conductor" type="material">
    <input name="materialFront" type="BSDF" nodename="gold_bsdf" />
    <input name="materialBack" type="BSDF" nodename="gold_bsdf" />
    <input name="presence" type="float" value="1" />
  </LamaSurface>

  <LamaGeneralizedSchlick name="schlick_bsdf" type="BSDF">
    <input name="fresnelMode" type="integer" value="0" />
    <input name="reflectivity" type="color3" value="0.04, 0.08, 0.14" />
    <input name="reflectivity90" type="color3" value="1, 0.72, 0.45" />
    <input name="reflectivityProfile" type="float" value="0.25" />
    <input name="roughness" type="float" value="0.22" />
    <input name="transmissionTint" type="color3" value="0.9, 0.96, 1" />
  </LamaGeneralizedSchlick>
  <LamaSurface name="schlick" type="material">
    <input name="materialFront" type="BSDF" nodename="schlick_bsdf" />
    <input name="materialBack" type="BSDF" nodename="schlick_bsdf" />
    <input name="presence" type="float" value="1" />
  </LamaSurface>

  <LamaDiffuse name="diffuse_bsdf" type="BSDF">
    <input name="color" type="color3" value="0.22, 0.48, 0.72" />
    <input name="roughness" type="float" value="0.45" />
  </LamaDiffuse>
  <LamaDielectric name="coat_bsdf" type="BSDF">
    <input name="fresnelMode" type="integer" value="1" />
    <input name="IOR" type="float" value="1.5" />
    <input name="roughness" type="float" value="0.08" />
  </LamaDielectric>
  <LamaLayer name="layer_bsdf" type="BSDF">
    <input name="materialTop" type="BSDF" nodename="coat_bsdf" />
    <input name="materialBase" type="BSDF" nodename="diffuse_bsdf" />
    <input name="topMix" type="float" value="0.65" />
  </LamaLayer>
  <LamaSurface name="layered" type="material">
    <input name="materialFront" type="BSDF" nodename="layer_bsdf" />
    <input name="materialBack" type="BSDF" nodename="layer_bsdf" />
    <input name="presence" type="float" value="1" />
  </LamaSurface>

  <LamaSheen name="sheen_bsdf" type="BSDF">
    <input name="color" type="color3" value="0.8, 0.35, 0.12" />
    <input name="roughness" type="float" value="0.4" />
  </LamaSheen>
  <LamaMix name="mix_bsdf" type="BSDF">
    <input name="material1" type="BSDF" nodename="diffuse_bsdf" />
    <input name="material2" type="BSDF" nodename="sheen_bsdf" />
    <input name="mix" type="float" value="0.45" />
  </LamaMix>
  <LamaSurface name="mixed" type="material">
    <input name="materialFront" type="BSDF" nodename="mix_bsdf" />
    <input name="materialBack" type="BSDF" nodename="mix_bsdf" />
    <input name="presence" type="float" value="1" />
  </LamaSurface>
</materialx>