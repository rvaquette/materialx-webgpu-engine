<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <disney_principled name="mat_cube_surface" type="surfaceshader">
    <input name="baseColor" type="color3" value="0.8, 0.2, 0.2" />
    <input name="metallic" type="float" value="0" />
    <input name="roughness" type="float" value="0.2" />
  </disney_principled>
  <surfacematerial name="mat_cube" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="mat_cube_surface" />
  </surfacematerial>
  <disney_principled name="mat_sphere_surface" type="surfaceshader">
    <input name="baseColor" type="color3" value="0.2, 0.8, 0.2" />
    <input name="metallic" type="float" value="0" />
    <input name="roughness" type="float" value="0.2" />
  </disney_principled>
  <surfacematerial name="mat_sphere" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="mat_sphere_surface" />
  </surfacematerial>
  <disney_principled name="mat_ground_surface" type="surfaceshader">
    <input name="baseColor" type="color3" value="0.5, 0.5, 0.5" />
    <input name="roughness" type="float" value="0.5" />
  </disney_principled>
  <surfacematerial name="mat_ground" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="mat_ground_surface" />
  </surfacematerial>
</materialx>
