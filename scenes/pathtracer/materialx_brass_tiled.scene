renderer
{
    resolution 1280 720
    maxdepth 8
    tilewidth 256
    tileheight 144
    envmapfile HDR/san_giuseppe_bridge_split.hdr
}

camera
{
    position -0.05 1.05 3.58
    lookat -0.05 1.05 -0.06
    fov 45
}

material brass_tiled
{
    materialx_document ../materialx/materials/Examples/StandardSurface/standard_surface_brass_tiled.mtlx
    materialx_surface Tiled_Brass
}

mesh
{
    name cube_onyx
    file materialx_test/ShaderBall.obj
    material brass_tiled
}

