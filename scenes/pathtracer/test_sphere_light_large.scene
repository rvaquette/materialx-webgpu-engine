renderer
{
	resolution 800 800
	maxdepth 2
	tilewidth 200
	tileheight 200
	enabletonemap false
}

camera
{
	position 3 0.25 0
	lookat 0 0.5 0
	fov 40
}

material white
{
	color 1 1 1
	roughness 1.0
}

mesh
{
	name floor
	file light_tests/floor.obj
	material white
}

light
{
	emission 1 1 1
	position 0 1 0
	radius 1
	type sphere
}
