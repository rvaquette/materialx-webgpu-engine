#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 100
    framesPerSecond = 30
    metersPerUnit = 0.01
    startTimeCode = 0
    subLayers = [
        @materials/bubbles.usda@,
        @materials/iceCube.usda@,
        @materials/orangeJuice.usda@,
        @materials/straw.usda@
    ]
    timeCodesPerSecond = 30
    upAxis = "Y"
)

def Xform "World"
{
    over "orangeJuice_grp" (
        prepend references = @orangeJuice_grp.usd@</World/orangeJuice_grp>
    )
    {
        token visibility = "inherited"

        over "bubble2_geo"
        {
            uniform token subdivisionScheme = "catmullClark"
            token visibility = "inherited"
            float3 xformOp:scale = (0.96, 0.96, 0.96)
        }

        over "juice_geo_smoothed"
        {
            uniform token subdivisionScheme = "catmullClark"
            float3 xformOp:scale = (0.97, 0.97, 0.97)
        }

        over "bubbles1_geo"
        {
            uniform token subdivisionScheme = "catmullClark"
            token visibility = "inherited"
            float3 xformOp:scale = (0.94, 0.96, 0.94)
        }

        over "foamMesh_ORIG"
        {
            uniform token subdivisionScheme = "catmullClark"
            float3 xformOp:scale = (0.98, 0.98, 0.98)
        }

        over "foamMesh_smoothed"
        {
            uniform token subdivisionScheme = "catmullClark"
