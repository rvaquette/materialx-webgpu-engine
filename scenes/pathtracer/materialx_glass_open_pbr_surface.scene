renderer
{
    resolution 1280 720
    maxdepth 8
    tilewidth 256
    tileheight 144
    envmapfile HDR/san_giuseppe_bridge_split.hdr
    envmapintensity 4.0
    envmaprotation -90
}

camera
{
    position -0.05 1.05 3.58
    lookat -0.05 1.05 -0.06
    fov 45
}

material mtlx_test
{
    materialx_document ../materialx/materials/showcase/open_pbr_surface/glass/glass.mtlx
    materialx_surface Glass
}

mesh
{
    name cube_onyx
    file materialx_test/ShaderBall.obj
    material mtlx_test
}

