#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

def Xform "World" {
    def Xform "Geometry" {
        def Mesh "NeutralObjects" {
            uniform token subdivisionScheme = "none"
            custom asset engine:geometry:file = @./geometry/neutral_objects.glb@
            rel material:binding = </World/Looks/NeutralMaterial>
        }
        def Mesh "OpenPBRShaderBall" {
            uniform token subdivisionScheme = "none"
            custom asset engine:geometry:file = @./geometry/openpbr_objects.glb@
            rel material:binding = </World/Looks/OpenPBRMaterial>
        }
    }

    def Mesh "Ground" {
        uniform token subdivisionScheme = "none"
        custom asset engine:geometry:file = @./geometry/ground.obj@
        custom string engine:geometry:object = "Ground"
        rel material:binding = </World/Looks/GroundMaterial>
    }

    def Scope "Looks" {
        def Material "NeutralMaterial" {
            token outputs:surface.connect = </World/Looks/NeutralMaterial/Surface.outputs:surface>
            def Shader "Surface" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5, 0.5, 0.5)
                float inputs:roughness = 1
                float inputs:metallic = 0
                token outputs:surface
            }
        }
        def Material "OpenPBRMaterial" {
            token outputs:surface.connect = </World/Looks/OpenPBRMaterial/Surface.outputs:surface>
            def Shader "Surface" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.8, 0.8)
                float inputs:roughness = 0.1
                float inputs:metallic = 0
                token outputs:surface
            }
        }
        def Material "GroundMaterial" {
            token outputs:surface.connect = </World/Looks/GroundMaterial/Surface.outputs:surface>
            def Shader "Surface" {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor.connect = </World/Looks/GroundMaterial/GroundTexture.outputs:rgb>
                float inputs:roughness = 1
                token outputs:surface
            }
            def Shader "GroundTexture" {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @./textures/ground.png@
                token inputs:sourceColorSpace = "sRGB"
                token inputs:wrapS = "repeat"
                token inputs:wrapT = "repeat"
                float2 inputs:st.connect = </World/Looks/GroundMaterial/ST.outputs:result>
                float3 outputs:rgb
            }
            def Shader "ST" {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
        }
    }

    def Camera "RenderCamera" {
        matrix4d xformOp:transform = (            (0.939801516, -1.38777878e-17, -0.341720807, 0),
            (-0.212914679, 0.782169119, -0.585558544, 0),
            (0.267283462, 0.623066184, 0.735083724, 0),
            (6.53153892, 19.5, 17.9485218, 1))
        uniform token[] xformOpOrder = ["xformOp:transform"]
        float focalLength = 50
        float horizontalAperture = 20.9549999
        float verticalAperture = 20.9549999
        float2 clippingRange = (0.01, 1000)
    }

    def DomeLight "Environment" {
        token inputs:texture:format = "latlong"
        asset inputs:texture:file = @./envmaps/san_giuseppe_bridge.hdr@
        asset inputs:texture:irradianceFile = @./envmaps/irradiance/san_giuseppe_bridge.hdr@
        float inputs:intensity = 1
    }

}
