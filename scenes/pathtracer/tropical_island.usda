#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    doc = "tropical_island converted from GLSL-PathTracer .scene"
)

def Xform "World"
{
    custom string pathtracer:sourceScene = "tropical_island.scene"
    custom int2 pathtracer:resolution = (800, 800)
    custom int pathtracer:maxDepth = 4
    custom float pathtracer:environmentIntensity = 1
    custom asset pathtracer:environment = @./HDR/spiaggia_di_mondello_4k_new.hdr@

    def Camera "Camera"
    {
        matrix4d xformOp:transform = ((-0.538849802537, 0, -0.842401857967, 0), (-0.642273732429, 0.647068907567, 0.410836076181, 0), (0.545092049967, 0.762431524047, -0.34867295307, 0), (9.38, 13.12, -6, 1))
        uniform token[] xformOpOrder = ["xformOp:transform"]
        token projection = "perspective"
        float focalLength = 50
        float horizontalAperture = 8.74886635259
        float verticalAperture = 8.74886635259
        float2 clippingRange = (0.001, 1000000)
        custom point3f pathtracer:lookAt = (0, 0, 0)
        custom float pathtracer:fov = 10
    }

    def Scope "Looks"
    {
        def Material "water" (
            prepend references = @./tropical_island.mtlx@</MaterialX/Materials/water>
        )
        {
        }
        def Material "wood" (
            prepend references = @./tropical_island.mtlx@</MaterialX/Materials/wood>
        )
        {
        }
        def Material "floor" (
            prepend references = @./tropical_island.mtlx@</MaterialX/Materials/floor>
        )
        {
        }
        def Material "grass" (
            prepend references = @./tropical_island.mtlx@</MaterialX/Materials/grass>
        )
        {
        }
        def Material "rock" (
            prepend references = @./tropical_island.mtlx@</MaterialX/Materials/rock>
        )
        {
        }
        def Material "sand" (
            prepend references = @./tropical_island.mtlx@</MaterialX/Materials/sand>
        )
        {
        }
        def Material "palm" (
            prepend references = @./tropical_island.mtlx@</MaterialX/Materials/palm>
        )
        {
        }
    }

    def Scope "Geometry"
    {
        def Mesh "boat"
        {
            custom asset engine:geometry:file = @./tropical_island/boat.obj@

            rel material:binding = </World/Looks/wood>
