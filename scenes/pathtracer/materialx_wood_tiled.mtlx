<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- source MaterialX: ../materialx/materials/Examples/StandardSurface/standard_surface_wood_tiled.mtlx; surface: Tiled_Wood; converted to DisneyPrincipled -->
  <disney_principled name="wood_tiled_surface" type="surfaceshader">
    <input name="baseColor" type="color3" value="0.8, 0.8, 0.8" />
  </disney_principled>
  <surfacematerial name="wood_tiled" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="wood_tiled_surface" />
  </surfacematerial>
  <disney_principled name="ground_surface" type="surfaceshader">
    <input name="baseColor" type="color3" value="0.5, 0.5, 0.5" />
    <input name="metallic" type="float" value="0" />
    <input name="roughness" type="float" value="0.55" />
  </disney_principled>
  <surfacematerial name="ground" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="ground_surface" />
  </surfacematerial>
</materialx>
