<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Volumetric cube using anisotropic_vdf closure in a transmissive surface -->
  <!-- This surface shader composes a VDF closure for volumetric effects -->
  
  <!-- Core VDF for volumetric scattering -->
  <anisotropic_vdf name="volume_vdf" type="VDF">
    <input name="absorption" type="color3" value="0.05, 0.05, 0.08" />
    <input name="scattering" type="color3" value="0.1, 0.12, 0.1" />
    <input name="anisotropy" type="float" value="0.3" />
  </anisotropic_vdf>
  
  <!-- Surface shader that includes VDF for volume support -->
  <!-- Transmission is glass-like with internal volume scattering -->
  <standard_surface name="volume_surface" type="surfaceshader">
    <input name="base_color" type="color3" value="1, 1, 1" />
    <input name="specular_roughness" type="float" value="0.0" />
    <input name="transmission" type="float" value="1" />
    <input name="transmission_color" type="color3" value="1, 1, 1" />
    <input name="subsurface_color" type="color3" value="0.8, 0.8, 0.8" />
  </standard_surface>
  
  <!-- Material using the volumetric surface -->
  <surfacematerial name="volume_material" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="volume_surface" />
  </surfacematerial>
  
  <!-- Dark surface for floor (no volume) -->
  <standard_surface name="black_surface" type="surfaceshader">
    <input name="base_color" type="color3" value="0.1, 0.1, 0.1" />
    <input name="specular_roughness" type="float" value="0.707106781187" />
    <input name="diffuse_roughness" type="float" value="0.5" />
  </standard_surface>
  
  <surfacematerial name="black" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="black_surface" />
  </surfacematerial>
</materialx>
