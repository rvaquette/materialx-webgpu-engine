#usda 1.0
(
    defaultPrim = "World"
    endTimeCode = 100
    framesPerSecond = 30
    metersPerUnit = 0.01
    startTimeCode = 0
    subLayers = [
        @materials/masonJar.usda@,
        @materials/paintBrushes.usda@
    ]
    timeCodesPerSecond = 30
    upAxis = "Y"
)

def Xform "World"
{
    over "masonJar_grp" (
        prepend references = @masonJar_grp_geometry.usda@</World/masonJar_grp>
    )
    {
        over "jar_geo_n3d" (
            prepend apiSchemas = ["MaterialBindingAPI"]
        )
        {
            token interpolateBoundary = "edgeAndCorner"
            rel material:binding = </World/Looks/masonJarGlass> (
                bindMaterialAs = "weakerThanDescendants"
            )
            bool primvars:disableAutoLod = 1
            bool primvars:doNotCastShadows = 0
            bool primvars:enableFastRefractionShadow = 0
            bool refinementEnableOverride = 1
            int refinementLevel = 0
            uniform token subdivisionScheme = "catmullClark"
            token triangleSubdivisionRule = "catmullClark"
            token visibility = "inherited"
        }

        over "water_geo_n3d"
        {
            bool refinementEnableOverride = 1
            int refinementLevel = 0
            uniform token subdivisionScheme = "catmullClark"
            token visibility = "inherited"
            float3 xformOp:rotateXYZ = (0, 0, 0)
            float3 xformOp:scale = (0.98, 0.98, 0.98)
            double3 xformOp:translate = (1.2079226507921703e-13, 0.036555668594855595, -1.2079226507921703e-13)
            float3 xformOp:translate:pivot = (-58.532436, -1.4, -19.15438)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:translate:pivot", "xformOp:rotateXYZ", "xformOp:scale", "!invert!xformOp:translate:pivot"]
        }

        over "zbrushBoolBubbles_geo1_n3d"
        {
            uniform token subdivisionScheme = "catmullClark"
            token visibility = "inherited"
            float3 xformOp:rotateXYZ = (0, 0, 0)
            float3 xformOp:scale = (0.95, 0.98, 0.95)
            double3 xformOp:translate = (-7.105427357601002e-15, -0.16574209059705947, -0.08402627818594155)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:translate:pivot", "xformOp:rotateXYZ", "xformOp:scale", "!invert!xformOp:translate:pivot"]
        }

        over "zbrushBoolBubbles_geo2_n3d"
        {
            uniform token subdivisionScheme = "catmullClark"
            float3 xformOp:rotateXYZ = (0, 0, 0)
            float3 xformOp:scale = (0.98, 0.98, 0.98)
            double3 xformOp:translate = (-7.105427357601002e-15, -0.1577315354871116, -0.037773126538574786)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:translate:pivot", "xformOp:rotateXYZ", "xformOp:scale", "!invert!xformOp:translate:pivot"]
        }

        over "zbrushBoolBubbles_geo3_n3d"
        {
            uniform token subdivisionScheme = "catmullClark"
            float3 xformOp:rotateXYZ = (0, 0, 0)
            float3 xformOp:scale = (0.98, 0.98, 0.98)
            double3 xformOp:translate = (0, -0.18201395159161837, -0.026914344167060733)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:translate:pivot", "xformOp:rotateXYZ", "xformOp:scale", "!invert!xformOp:translate:pivot"]
        }

        over "brushB_geo_n3d"
        {
            uniform token subdivisionScheme = "catmullClark"
        }

        over "bubbles1_geo2_n3d"
        {
            uniform token subdivisionScheme = "catmullClark"
        }

        over "bubbles1_geo1_n3d"
        {
            uniform token subdivisionScheme = "catmullClark"
        }
    }

    def Xform "lightRig" (
        kind = "assembly"
    )
    {
        def SphereLight "LEDmeetMat"
        {
            color3f inputs:color = (0.8307699, 0.66667366, 0.083077006)
            float inputs:diffuse = 1
            float inputs:exposure = 2.6
            float inputs:intensity = 400
            bool inputs:normalize = 1
            float inputs:radius = 3
            color3f inputs:shadow:color
            bool inputs:shadow:enable
            float inputs:specular = 1
            bool light:enableCaustics = 1
            string primvars:dcc_name = "LEDmeetMatShape" (
                elementSize = 1
                interpolation = "constant"
            )
            bool treatAsPoint = 0
            token visibility = "inherited"
            float3 xformOp:rotateXYZ = (0, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (-64.4521172485256, -1.786302246981709, -12.399562819686107)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        }

        def RectLight "moonLight_screenLFT"
        {
            color3f inputs:color = (0.42299998, 0.7659496, 1)
            float inputs:diffuse = 1
            float inputs:exposure = 5
            float inputs:height = 2
            float inputs:intensity = 900
            bool inputs:normalize = 1
            color3f inputs:shadow:color
            bool inputs:shadow:enable
            float inputs:specular = 1
            float inputs:width = 2
            string primvars:dcc_name = "moonLight_screenLFTShape" (
                elementSize = 1
                interpolation = "constant"
            )
            token visibility = "inherited"
            float3 xformOp:rotateXYZ = (-347.08002, -83.655426, 312.48502)
            float3 xformOp:scale = (60.003628, 75.95271, 49.46432)
            double3 xformOp:translate = (-325.45987166240855, 121.74850687733213, 62.55986030698268)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        }

        def DomeLight "aiSkyDomeLight1"
        {
            color3f inputs:color = (1, 1, 1)
            float inputs:diffuse = 1
            float inputs:exposure = 0
            float inputs:intensity = 1
            float inputs:specular = 1
            asset inputs:texture:file = @../HDR/bonifacio_aragon_stairs.hdr@
            token inputs:texture:format = "latlong"
            string primvars:dcc_name = "aiSkyDomeLightShape1" (
                elementSize = 1
                interpolation = "constant"
            )
            token visibility = "inherited"
            float3 xformOp:rotateXYZ = (-21.9, -846.5, 5.3)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        }

        def RectLight "sun_screenRight"
        {
            color3f inputs:color = (1, 0.8002714, 0.42299998)
            float inputs:diffuse = 1
            float inputs:exposure = 5
            float inputs:height = 2
            float inputs:intensity = 900
            bool inputs:normalize = 1
            color3f inputs:shadow:color
            bool inputs:shadow:enable
            float inputs:specular = 1
            float inputs:width = 2
            string primvars:dcc_name = "sun_screenRightShape" (
                elementSize = 1
                interpolation = "constant"
            )
            token visibility = "inherited"
            float3 xformOp:rotateXYZ = (165.0706, 114.27659, 193.70067)
            float3 xformOp:scale = (50.9468, 33.448547, 41.998276)
            double3 xformOp:translate = (188.69610658871187, 71.72841600669635, 73.56019615251049)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        }

        def RectLight "mainLamp_spill_AL"
        {
            color3f inputs:color = (0.905, 0.64324665, 0.47964996)
            float inputs:diffuse = 1
            float inputs:exposure = 2.6
            float inputs:height = 2
            float inputs:intensity = 1500
            bool inputs:normalize = 1
            float inputs:specular = 1
            float inputs:width = 2
            bool light:enableCaustics = 1
            string primvars:dcc_name = "mainLamp_spill_ALShape" (
                elementSize = 1
                interpolation = "constant"
            )
            token visibility = "inherited"
            float3 xformOp:rotateXYZ = (-83.8157, 20.941399, 13.864051)
            float3 xformOp:scale = (6.1584964, 6.1584964, 6.1584964)
            double3 xformOp:translate = (-17.767894870891602, 41.74111765252362, -15.586480885303336)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        }

        def RectLight "mainLamp_spill_AL1"
        {
            color3f inputs:color = (0.9049558, 0.8310189, 0.47933412)
            float inputs:diffuse = 1
            float inputs:exposure = 2.6
            float inputs:height = 2
            float inputs:intensity = 1500
            bool inputs:normalize = 1
            float inputs:specular = 1
            float inputs:width = 2
            string primvars:dcc_name = "mainLamp_spill_AL1Shape" (
                elementSize = 1
                interpolation = "constant"
            )
            token visibility = "inherited"
            float3 xformOp:rotateXYZ = (-95.8718, -21.027433, 192.99146)
            float3 xformOp:scale = (4.453885, 4.453885, 4.453885)
            double3 xformOp:translate = (-20.423473808149023, 55.55976851858026, -14.236616654942818)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ", "xformOp:scale"]
        }
    }
}

