renderer
{
	resolution 1280 720
	maxdepth 10
	tilewidth 256
	tileheight 144
	enabletonemap false
	envmapintensity 1.0
}

camera
{
	position 0.0 1.6 6.0
	lookat 0.0 1.0 0.0
	fov 40
}

material ground
{
	color 0.7 0.7 0.7
	roughness 0.85
	speculartint 0.0
}

material glass_thin
{
	color 1.0 1.0 1.0
	roughness 0.02
	metallic 0.0
	spectrans 1.0
	ior 1.52
	transmissioncolor 0.75 0.95 1.0
	thinwalled 1.0
	doublesided 0.0
}

material glass_solid
{
	color 1.0 1.0 1.0
	roughness 0.02
	metallic 0.0
	spectrans 1.0
	ior 1.52
	transmissioncolor 0.75 0.95 1.0
	thinwalled 0.0
	thickness 1.0
	mediumtype absorb
	mediumdensity 1.0
	mediumcolor 0.75 0.95 1.0
	doublesided 0.0
}

mesh
{
	name ground
	file material_test/floor.obj
	material ground
	scale 8.0 1.0 8.0
	position 0.0 0.0 0.0
}

mesh
{
	name thin_sphere
	file material_test/sphere.obj
	material glass_thin
	scale 1.0 1.0 1.0
	position -1.6 1.0 0.0
}

mesh
{
	name solid_sphere
	file material_test/sphere.obj
	material glass_solid
	scale 1.0 1.0 1.0
	position 1.6 1.0 0.0
}

mesh
{
	name thin_glass_plate
	file material_test/cube.obj
	material glass_thin
	scale 2.2 2.2 0.04
	position 0.0 1.1 -1.8
}

light
{
	type quad
	position -2.5 4.5 2.5
	v1 2.5 4.5 2.5
	v2 -2.5 4.5 7.5
	emission 8.0 8.0 8.0
}
