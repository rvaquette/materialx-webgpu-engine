#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    doc = "dragon converted from GLSL-PathTracer .scene"
)

def Xform "World"
{
    custom string pathtracer:sourceScene = "dragon.scene"
    custom int2 pathtracer:resolution = (1280, 720)
    custom int pathtracer:maxDepth = 8
    custom float pathtracer:environmentIntensity = 5
    custom asset pathtracer:environment = @./HDR/sunset.hdr@

    def Camera "Camera"
    {
        matrix4d xformOp:transform = ((-0.596324001338, 0, 0.802743847954, 0), (0.0914573995779, 0.993488666272, 0.0679397825436, 0), (-0.797516914862, 0.113930987837, -0.592441136755, 0), (-35, 12, -26, 1))
        uniform token[] xformOpOrder = ["xformOp:transform"]
        token projection = "perspective"
        float focalLength = 50
        float horizontalAperture = 57.735026919
        float verticalAperture = 32.4759526419
        float2 clippingRange = (0.001, 1000000)
        custom point3f pathtracer:lookAt = (0, 7, 0)
        custom float pathtracer:fov = 60
    }

    def Scope "Looks"
    {
        def Material "glass" (
            prepend references = @./dragon.mtlx@</MaterialX/Materials/glass>
        )
        {
        }
    }

    def Scope "Geometry"
    {
        def Mesh "Glass"
        {
            custom asset engine:geometry:file = @./dragon/dragon.obj@
            double3 xformOp:translate = (0, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
            rel material:binding = </World/Looks/glass>
        }
    }

    def Scope "Lights"
    {
        def DomeLight "Environment"
        {
            asset inputs:texture:file = @./HDR/sunset.hdr@
            float inputs:intensity = 5
            color3f inputs:color = (1, 1, 1)
        }
    }
}
