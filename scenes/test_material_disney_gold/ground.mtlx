<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <surfacematerial name="ground" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="ground_surface" />
  </surfacematerial>
  <open_pbr_surface name="ground_surface" type="surfaceshader">
    <input name="base_color" type="color3" value="0.5, 0.5, 0.5" />
    <input name="base_metalness" type="float" value="0" />
    <input name="specular_weight" type="float" value="1" />
    <input name="specular_roughness" type="float" value="0.5" />
  </open_pbr_surface>
</materialx>
