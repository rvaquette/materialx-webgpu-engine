            }

            over "pencil_frntMidLft_grp4FBXASC032eraser_001_mesh"
            {
                uniform token subdivisionScheme = "catmullClark"
            }
        }

        over "group51"
        {
            over "pencil_frntMidLft_grp1FBXASC032eraser_holder_001_mesh6"
            {
                uniform token subdivisionScheme = "catmullClark"
            }

            over "pencil_frntMidLft_grp1FBXASC032base_001_mesh"
            {
                uniform token subdivisionScheme = "catmullClark"
            }

            over "eraser_001_meshFBXASC032pencil_frntMidLft_grp1"
            {
                uniform token subdivisionScheme = "catmullClark"
            }
        }

        over "group52"
        {
            over "eraser_holder_001_mesh6FBXASC032pencil_frntMidLft_grp5"
            {
                uniform token subdivisionScheme = "catmullClark"
            }

