#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    doc = "hyperion_rect_lights converted from GLSL-PathTracer .scene"
)

def Xform "World"
{
    custom string pathtracer:sourceScene = "hyperion_rect_lights.scene"
    custom int2 pathtracer:resolution = (1280, 720)
    custom int pathtracer:maxDepth = 3

    def Camera "Camera"
    {
        matrix4d xformOp:transform = ((0, 0, 1, 0), (0.707106781187, 0.707106781187, 0, 0), (-0.707106781187, 0.707106781187, 0, 0), (-15, 15, 0, 1))
        uniform token[] xformOpOrder = ["xformOp:transform"]
        token projection = "perspective"
        float focalLength = 50
        float horizontalAperture = 57.735026919
        float verticalAperture = 32.4759526419
        float2 clippingRange = (0.001, 1000000)
        custom point3f pathtracer:lookAt = (0, 0, 0)
        custom float pathtracer:fov = 60
    }

