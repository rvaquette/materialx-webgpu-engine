<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <disney_principled name="test_surface" type="surfaceshader">
    <input name="baseColor" type="color3" value="0.8, 0, 0" />
    <input name="metallic" type="float" value="0" />
    <input name="roughness" type="float" value="0.01" />
    <input name="specularTint" type="float" value="1" />
    <input name="specTrans" type="float" value="1" />
  </disney_principled>
  <surfacematerial name="test" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="test_surface" />
  </surfacematerial>
  <disney_principled name="ground_surface" type="surfaceshader">
    <input name="baseColor" type="color3" value="0.5, 0.5, 0.5" />
    <input name="roughness" type="float" value="0.5" />
  </disney_principled>
  <surfacematerial name="ground" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="ground_surface" />
  </surfacematerial>
</materialx>
