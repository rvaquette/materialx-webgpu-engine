<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <LamaSSS name="skin" type="BSDF">
    <input name="color" type="color3" value="0.72, 0.28, 0.18" />
    <input name="sssRadius" type="color3" value="12, 6, 3" />
    <input name="sssUnitLength" type="float" value="0.001" />
    <input name="sssMode" type="integer" value="0" />
    <input name="albedoInversionMethod" type="integer" value="0" />
    <input name="sssBleed" type="float" value="0.5" />
    <input name="sssFollowTopology" type="float" value="0.25" />
    <input name="sssSubset" type="string" value="skin" />
    <input name="sssContinuationRays" type="integer" value="1" />
    <input name="sssIOR" type="float" value="1.3" />
    <input name="sssAnisotropy" type="float" value="0.15" />
    <input name="mode" type="integer" value="2" />
  </LamaSSS>
  <surface name="skin_surface" type="surfaceshader">
