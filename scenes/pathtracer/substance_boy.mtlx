<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <standard_surface name="head_surface" type="surfaceshader">
    <input name="base_color" type="color3" nodename="head_albedo_factor" />
    <input name="metalness" type="float" nodename="head_metallic_roughness_channels" output="outz" />
    <input name="specular_roughness" type="float" nodename="head_roughness_minimum" />
    <input name="diffuse_roughness" type="float" nodename="head_diffuse_roughness" />
    <input name="subsurface_color" type="color3" nodename="head_albedo_factor" />
    <input name="coat_roughness" type="float" value="0.316227766017" />
    <input name="normal" type="vector3" nodename="head_normal_mapped" />
    <input name="emission" type="float" value="1" />
    <input name="emission_color" type="color3" value="0, 0, 0" />
  </standard_surface>
  <image name="head_albedotexture_color3" type="color3">
    <input name="file" type="filename" value="substance_boy/textures/01_Head_Base_Color.png" />
  </image>
  <power name="head_albedo_linear" type="color3">
    <input name="in1" type="color3" nodename="head_albedotexture_color3" />
    <input name="in2" type="color3" value="2.2, 2.2, 2.2" />
  </power>
  <multiply name="head_albedo_factor" type="color3">
    <input name="in1" type="color3" nodename="head_albedo_linear" />
    <input name="in2" type="color3" value="1, 1, 1" />
  </multiply>
  <image name="head_metallicroughnesstexture_color3" type="color3">
    <input name="file" type="filename" value="substance_boy/textures/01_Head_MetallicRoughness.png" />
  </image>
  <separate3 name="head_metallic_roughness_channels" type="multioutput">
    <input name="in" type="color3" nodename="head_metallicroughnesstexture_color3" />
  </separate3>
  <max name="head_roughness_minimum" type="float">
    <input name="in1" type="float" nodename="head_metallic_roughness_channels" output="outy" />
    <input name="in2" type="float" value="0.0316227766017" />
  </max>
  <multiply name="head_diffuse_roughness" type="float">
    <input name="in1" type="float" nodename="head_roughness_minimum" />
    <input name="in2" type="float" nodename="head_roughness_minimum" />
  </multiply>
  <image name="head_normaltexture_vector3" type="vector3">
    <input name="file" type="filename" value="substance_boy/textures/01_Head_Normal_DirectX.png" />
  </image>
  <multiply name="head_normal_flip" type="vector3">
    <input name="in1" type="vector3" nodename="head_normaltexture_vector3" />
    <input name="in2" type="vector3" value="1, -1, 1" />
  </multiply>
  <add name="head_normal_encoded" type="vector3">
    <input name="in1" type="vector3" nodename="head_normal_flip" />
    <input name="in2" type="vector3" value="0, 1, 0" />
  </add>
  <normalmap name="head_normal_mapped" type="vector3">
    <input name="in" type="vector3" nodename="head_normal_encoded" />
  </normalmap>
  <surfacematerial name="head" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="head_surface" />
  </surfacematerial>
  <standard_surface name="body_surface" type="surfaceshader">
    <input name="base_color" type="color3" nodename="body_albedo_factor" />
